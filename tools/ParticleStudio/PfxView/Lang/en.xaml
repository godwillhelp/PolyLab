<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">
  <s:String x:Key="Title">NDZ Particle Studio — effect preview</s:String>
  <s:String x:Key="Btn.Open">Open…</s:String>
  <s:String x:Key="Tip.Open">Open a .ptc effect from disk</s:String>
  <s:String x:Key="Lbl.Roots">Data folders</s:String>
  <s:String x:Key="Tip.Roots">Folders that material and texture paths start from (the work drive, a mod folder), separated by ";". When a path is not found, the folder is looked for from the effect's location.</s:String>
  <s:String x:Key="Btn.Play">Play</s:String>
  <s:String x:Key="Btn.Pause">Pause</s:String>
  <s:String x:Key="Tip.Play">Start or stop playback</s:String>
  <s:String x:Key="Btn.Step">Step</s:String>
  <s:String x:Key="Tip.Step">One simulation step forward (while paused)</s:String>
  <s:String x:Key="Btn.Restart">Restart</s:String>
  <s:String x:Key="Tip.Restart">Start the effect again from time zero</s:String>
  <s:String x:Key="Lbl.Seed">Seed</s:String>
  <s:String x:Key="Tip.Seed">Random seed: the same seed and step give the same particles</s:String>
  <s:String x:Key="Lbl.StepSize">Step, s</s:String>
  <s:String x:Key="Tip.StepSize">Simulation step in seconds (default 1/60). The game's own step is not measured</s:String>
  <s:String x:Key="Lbl.View">View</s:String>
  <s:String x:Key="View.Free">Free</s:String>
  <s:String x:Key="View.Top">Top</s:String>
  <s:String x:Key="View.Side">Side</s:String>
  <s:String x:Key="View.Front">Front</s:String>
  <s:String x:Key="View.Eye">Eye 1.7 m</s:String>
  <s:String x:Key="Tip.View.Free">Camera at an angle to the source</s:String>
  <s:String x:Key="Tip.View.Top">Camera from above, north up</s:String>
  <s:String x:Key="Tip.View.Side">Camera from the east, looking west</s:String>
  <s:String x:Key="Tip.View.Front">Camera from the south, looking north</s:String>
  <s:String x:Key="Tip.View.Eye">Camera at a player's eye height (1.7 m), looking level</s:String>
  <s:String x:Key="Lbl.Fov">View, °</s:String>
  <s:String x:Key="Tip.Fov">Vertical field of view, 5–120° (as in the Workbench editor, default 45°)</s:String>
  <s:String x:Key="Lbl.Sky">Sky</s:String>
  <s:String x:Key="Sky.noon">Noon</s:String>
  <s:String x:Key="Sky.dusk">Dusk (not measured)</s:String>
  <s:String x:Key="Sky.night">Night (not measured)</s:String>
  <s:String x:Key="Tip.Sky">Scene light. Noon is taken from the game (R0 capture); dusk and night are approximate and not measured in the game</s:String>
  <s:String x:Key="Chk.Fog">Fog</s:String>
  <s:String x:Key="Tip.Fog">Particle fog from the game's shaders (in place of post-processing). The game's post-processing after the particles is not reproduced</s:String>
  <s:String x:Key="Chk.Ground">Ground</s:String>
  <s:String x:Key="Tip.Ground">Show the ground with a 1 m and 10 m grid; soft particles fade at the ground</s:String>
  <s:String x:Key="Lbl.Helper">Model</s:String>
  <s:String x:Key="Helper.None">None</s:String>
  <s:String x:Key="Helper.Box">1 m box</s:String>
  <s:String x:Key="Helper.Player">1.8 m player</s:String>
  <s:String x:Key="Tip.Helper">A model for scale, on the ground 2 m east of the source</s:String>
  <s:String x:Key="Chk.Gizmos">Cone and volume</s:String>
  <s:String x:Key="Tip.Gizmos">Show each emitter's emission cone (ConeAngle: band B/2…C/2) and source volume (ShapeType, ShapeSize)</s:String>
  <s:String x:Key="Lbl.Motion">Motion</s:String>
  <s:String x:Key="Motion.Still">Still</s:String>
  <s:String x:Key="Motion.Circle">Circle</s:String>
  <s:String x:Key="Motion.Turn">Turn</s:String>
  <s:String x:Key="Tip.Motion">Source motion: a circle as in the Workbench editor, or turning in place like a script turn</s:String>
  <s:String x:Key="Lbl.Radius">Radius, m</s:String>
  <s:String x:Key="Tip.Radius">Radius of the circle the source travels (Workbench default 2 m)</s:String>
  <s:String x:Key="Lbl.Speed">Speed, m/s</s:String>
  <s:String x:Key="Tip.Speed">Speed of the source on the circle (Workbench default 4 m/s)</s:String>
  <s:String x:Key="Lbl.Axis">Axis</s:String>
  <s:String x:Key="Tip.Axis">Axis the circle goes around (Y = a circle on the ground)</s:String>
  <s:String x:Key="Lbl.Turn">Turn, °/s</s:String>
  <s:String x:Key="Tip.Turn">Turning speed of the source; plus = clockwise seen from above</s:String>
  <s:String x:Key="Lbl.Copies">Copies</s:String>
  <s:String x:Key="Tip.Copies">Stress test: how many copies of the effect to place in a grid. Particle count and frame time show in the corner of the view</s:String>
  <s:String x:Key="Lbl.Spacing">Spacing, m</s:String>
  <s:String x:Key="Tip.Spacing">Distance between stress-test copies</s:String>
  <s:String x:Key="Lbl.LowFps">Low FPS</s:String>
  <s:String x:Key="Tip.LowFps">Show the effect at this frame rate, the simulation steps once per frame (0 = off). In Workbench this is always 16 frames/s</s:String>
  <s:String x:Key="Btn.Shot">Screenshot</s:String>
  <s:String x:Key="Tip.Shot">Save the current preview frame as PNG</s:String>
  <s:String x:Key="Btn.Loss">Reset device</s:String>
  <s:String x:Key="Tip.Loss">Check: destroy the Direct3D device with all its resources and create them again, as after a driver failure</s:String>
  <s:String x:Key="Lbl.Lang">Language</s:String>
  <s:String x:Key="Tip.Lang">Interface language</s:String>
  <s:String x:Key="Ov.NoEffect">No effect open</s:String>
  <s:String x:Key="Ov.Time">{0} · time {1:0.00} s{2}</s:String>
  <s:String x:Key="Ov.LowFps"> · showing {0:0.#} frames/s</s:String>
  <s:String x:Key="Ov.Paused"> · paused</s:String>
  <s:String x:Key="Ov.Frame">frame {0:0.0} ms · CPU {1:0.00} ms (simulation {2:0.00}, upload {3:0.00}) · GPU {4}</s:String>
  <s:String x:Key="Ov.Particles">particles {0} · draws {1} · copies {2}</s:String>
  <s:String x:Key="Ov.Emitter">{0}: {1}/{2}</s:String>
  <s:String x:Key="Ov.Resets">device re-creations: {0}</s:String>
  <s:String x:Key="Ov.Help">LMB — orbit · Shift+LMB or MMB — pan · wheel — closer · RMB + WASD/QE — fly</s:String>
  <s:String x:Key="Ov.Ms">{0:0.00} ms (timestamp)</s:String>
  <s:String x:Key="Ov.Emitters">emitters {0} · may swap {1}</s:String>
  <s:String x:Key="Ov.More">… and {0} more</s:String>
  <s:String x:Key="Ov.Na">—</s:String>
  <s:String x:Key="Flag.ShapeNotDrawnInGame">not drawn in game (sized Cone/OnSphere)</s:String>
  <s:String x:Key="Flag.BirthRateRndMean">BirthRateRND: game mean is +0.73·RND</s:String>
  <s:String x:Key="Flag.WindLaw">Wind: law not measured</s:String>
  <s:String x:Key="Flag.RestitutionFreezes">particles freeze in game (Restitution &gt; 0)</s:String>
  <s:String x:Key="Flag.SpringFrameRate">Spring: frame-rate dependence not checked</s:String>
  <s:String x:Key="Flag.AngleOrder">Angles: rotation order not checked</s:String>
  <s:String x:Key="Flag.MaterialMissing">material not found</s:String>
  <s:String x:Key="Flag.TextureMissing">texture not found</s:String>
  <s:String x:Key="Flag.Streak">ParticleStreak: not drawn in game</s:String>
  <s:String x:Key="Flag.MaySwap">may swap with its neighbour</s:String>
  <s:String x:Key="Msg.Saved">Saved: {0}</s:String>
  <s:String x:Key="Msg.OpenFailed">Could not open {0}: {1}</s:String>
</ResourceDictionary>
