<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">
  <s:String x:Key="Title">NDZ Particle Studio — просмотр эффекта</s:String>
  <s:String x:Key="Btn.Open">Открыть…</s:String>
  <s:String x:Key="Tip.Open">Открыть эффект .ptc с диска</s:String>
  <s:String x:Key="Lbl.Roots">Папки данных</s:String>
  <s:String x:Key="Tip.Roots">Папки, от которых отсчитываются пути материалов и текстур (рабочий диск, папка мода), через «;». Если путь не найден, папка ищется по расположению эффекта.</s:String>
  <s:String x:Key="Btn.Play">Пуск</s:String>
  <s:String x:Key="Btn.Pause">Пауза</s:String>
  <s:String x:Key="Tip.Play">Запустить или остановить проигрывание</s:String>
  <s:String x:Key="Btn.Step">Шаг</s:String>
  <s:String x:Key="Tip.Step">Один шаг симуляции вперёд (на паузе)</s:String>
  <s:String x:Key="Btn.Restart">Сначала</s:String>
  <s:String x:Key="Tip.Restart">Запустить эффект заново с нулевого времени</s:String>
  <s:String x:Key="Lbl.Seed">Зерно</s:String>
  <s:String x:Key="Tip.Seed">Зерно случайных чисел: одно и то же зерно и шаг дают одни и те же частицы</s:String>
  <s:String x:Key="Lbl.StepSize">Шаг, с</s:String>
  <s:String x:Key="Tip.StepSize">Шаг симуляции в секундах (по умолчанию 1/60). Шаг движка в игре не измерен</s:String>
  <s:String x:Key="Lbl.View">Вид</s:String>
  <s:String x:Key="View.Free">Свободно</s:String>
  <s:String x:Key="View.Top">Сверху</s:String>
  <s:String x:Key="View.Side">Сбоку</s:String>
  <s:String x:Key="View.Front">Спереди</s:String>
  <s:String x:Key="View.Eye">Глаза 1,7 м</s:String>
  <s:String x:Key="Tip.View.Free">Камера под углом к источнику</s:String>
  <s:String x:Key="Tip.View.Top">Камера сверху, север вверху</s:String>
  <s:String x:Key="Tip.View.Side">Камера с востока, смотрит на запад</s:String>
  <s:String x:Key="Tip.View.Front">Камера с юга, смотрит на север</s:String>
  <s:String x:Key="Tip.View.Eye">Камера на высоте глаз игрока (1,7 м), смотрит горизонтально</s:String>
  <s:String x:Key="Lbl.Fov">Обзор, °</s:String>
  <s:String x:Key="Tip.Fov">Вертикальный угол обзора камеры, 5–120° (как в редакторе Workbench, по умолчанию 45°)</s:String>
  <s:String x:Key="Lbl.Sky">Небо</s:String>
  <s:String x:Key="Sky.noon">Полдень</s:String>
  <s:String x:Key="Sky.dusk">Сумерки (не измерено)</s:String>
  <s:String x:Key="Sky.night">Ночь (не измерено)</s:String>
  <s:String x:Key="Tip.Sky">Свет сцены. Полдень снят с игры (захват R0); сумерки и ночь приблизительные, в игре не измерены</s:String>
  <s:String x:Key="Chk.Fog">Туман</s:String>
  <s:String x:Key="Tip.Fog">Туман частиц из шейдеров игры (вместо постобработки). Постобработку игры после частиц просмотр не повторяет</s:String>
  <s:String x:Key="Chk.Ground">Земля</s:String>
  <s:String x:Key="Tip.Ground">Показать землю с сеткой 1 м и 10 м; мягкие частицы гаснут у земли</s:String>
  <s:String x:Key="Lbl.Helper">Модель</s:String>
  <s:String x:Key="Helper.None">Нет</s:String>
  <s:String x:Key="Helper.Box">Куб 1 м</s:String>
  <s:String x:Key="Helper.Player">Игрок 1,8 м</s:String>
  <s:String x:Key="Tip.Helper">Модель для масштаба, на земле в 2 м к востоку от источника</s:String>
  <s:String x:Key="Chk.Gizmos">Конус и объём</s:String>
  <s:String x:Key="Tip.Gizmos">Показать конус вылета (ConeAngle: полоса B/2…C/2) и объём источника (ShapeType, ShapeSize) каждого эмиттера</s:String>
  <s:String x:Key="Lbl.Motion">Движение</s:String>
  <s:String x:Key="Motion.Still">Стоит</s:String>
  <s:String x:Key="Motion.Circle">По кругу</s:String>
  <s:String x:Key="Motion.Turn">Вращение</s:String>
  <s:String x:Key="Tip.Motion">Движение источника: круг, как в редакторе Workbench, или вращение на месте, как поворот из скрипта</s:String>
  <s:String x:Key="Lbl.Radius">Радиус, м</s:String>
  <s:String x:Key="Tip.Radius">Радиус круга, по которому едет источник (в Workbench по умолчанию 2 м)</s:String>
  <s:String x:Key="Lbl.Speed">Скорость, м/с</s:String>
  <s:String x:Key="Tip.Speed">Скорость источника на круге (в Workbench по умолчанию 4 м/с)</s:String>
  <s:String x:Key="Lbl.Axis">Ось</s:String>
  <s:String x:Key="Tip.Axis">Ось, вокруг которой идёт круг (Y — круг по земле)</s:String>
  <s:String x:Key="Lbl.Turn">Поворот, °/с</s:String>
  <s:String x:Key="Tip.Turn">Скорость вращения источника; плюс — по часовой стрелке, если смотреть сверху</s:String>
  <s:String x:Key="Lbl.Copies">Копий</s:String>
  <s:String x:Key="Tip.Copies">Нагрузочный тест: сколько копий эффекта поставить сеткой. Число частиц и время кадра видны в углу просмотра</s:String>
  <s:String x:Key="Lbl.Spacing">Шаг, м</s:String>
  <s:String x:Key="Tip.Spacing">Расстояние между копиями нагрузочного теста</s:String>
  <s:String x:Key="Lbl.LowFps">Низкий FPS</s:String>
  <s:String x:Key="Tip.LowFps">Показывать эффект с этой частотой кадров, симуляция шагает раз в кадр (0 — выключено). В Workbench это всегда 16 кадров/с</s:String>
  <s:String x:Key="Btn.Shot">Снимок</s:String>
  <s:String x:Key="Tip.Shot">Сохранить текущий кадр просмотра в PNG</s:String>
  <s:String x:Key="Btn.Loss">Сброс устройства</s:String>
  <s:String x:Key="Tip.Loss">Проверка: уничтожить устройство Direct3D со всеми ресурсами и создать заново, как после сбоя драйвера</s:String>
  <s:String x:Key="Lbl.Lang">Язык</s:String>
  <s:String x:Key="Tip.Lang">Язык интерфейса</s:String>
  <s:String x:Key="Ov.NoEffect">Эффект не открыт</s:String>
  <s:String x:Key="Ov.Time">{0} · время {1:0.00} с{2}</s:String>
  <s:String x:Key="Ov.LowFps"> · показ {0:0.#} кадр/с</s:String>
  <s:String x:Key="Ov.Paused"> · пауза</s:String>
  <s:String x:Key="Ov.Frame">кадр {0:0.0} мс · CPU {1:0.00} мс (симуляция {2:0.00}, загрузка {3:0.00}) · GPU {4}</s:String>
  <s:String x:Key="Ov.Particles">частиц {0} · отрисовок {1} · копий {2}</s:String>
  <s:String x:Key="Ov.Emitter">{0}: {1}/{2}</s:String>
  <s:String x:Key="Ov.Resets">пересозданий устройства: {0}</s:String>
  <s:String x:Key="Ov.Help">ЛКМ — вращать · Shift+ЛКМ или СКМ — сдвиг · колесо — ближе · ПКМ + WASD/QE — полёт</s:String>
  <s:String x:Key="Ov.Ms">{0:0.00} мс (метка времени)</s:String>
  <s:String x:Key="Ov.Emitters">эмиттеров {0} · могут меняться местами {1}</s:String>
  <s:String x:Key="Ov.More">… и ещё {0}</s:String>
  <s:String x:Key="Ov.Na">—</s:String>
  <s:String x:Key="Flag.ShapeNotDrawnInGame">в игре не рисуется (Cone/OnSphere с размером)</s:String>
  <s:String x:Key="Flag.BirthRateRndMean">BirthRateRND: в игре в среднем +0,73·RND</s:String>
  <s:String x:Key="Flag.WindLaw">Wind: закон не измерен</s:String>
  <s:String x:Key="Flag.RestitutionFreezes">в игре частицы замирают (Restitution &gt; 0)</s:String>
  <s:String x:Key="Flag.SpringFrameRate">Spring: зависимость от FPS не проверена</s:String>
  <s:String x:Key="Flag.AngleOrder">Angles: порядок поворотов не проверен</s:String>
  <s:String x:Key="Flag.MaterialMissing">материал не найден</s:String>
  <s:String x:Key="Flag.TextureMissing">текстура не найдена</s:String>
  <s:String x:Key="Flag.Streak">ParticleStreak: в игре не рисуется</s:String>
  <s:String x:Key="Flag.MaySwap">может меняться местами с соседом</s:String>
  <s:String x:Key="Msg.Saved">Сохранено: {0}</s:String>
  <s:String x:Key="Msg.OpenFailed">Не удалось открыть {0}: {1}</s:String>
</ResourceDictionary>
