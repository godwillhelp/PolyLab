<UserControl x:Class="Pfx.App.Views.XrayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xr="clr-namespace:Pfx.App.XRay"
             xmlns:c="clr-namespace:Pfx.App.Controls">
  <UserControl.Resources>
    <c:ThemeBrush x:Key="Brush" />
    <Style TargetType="TextBlock" BasedOn="{StaticResource T.Base}" />
    <Style x:Key="Small" TargetType="TextBlock" BasedOn="{StaticResource T.Dim}">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Seg" TargetType="ToggleButton" BasedOn="{StaticResource Btn.Seg}">
      <Setter Property="Margin" Value="0,0,-1,4" />
    </Style>
  </UserControl.Resources>
  <DockPanel Background="{StaticResource B.BgPanel}">
    <Border DockPanel.Dock="Left" Width="330" BorderBrush="{StaticResource B.LineSubtle}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="6,5,6,2">
          <DockPanel>
            <ComboBox x:Name="TypeBox" DockPanel.Dock="Right" Width="104" Margin="4,0,0,0" ToolTip="{DynamicResource Tip.Xr.TypeBox}" SelectionChanged="OnFilter" />
            <TextBox x:Name="SearchBox" Style="{StaticResource Box.Num}" ToolTip="{DynamicResource Tip.Xr.Search}" TextChanged="OnFilter" />
          </DockPanel>
          <WrapPanel x:Name="KindBar" Margin="0,5,0,0" />
        </StackPanel>
        <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Style="{StaticResource Small}" Margin="8,2,6,4" TextWrapping="Wrap" />
        <ListBox x:Name="ResultList" BorderThickness="0" Background="{StaticResource B.BgInput}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" ToolTip="{DynamicResource Tip.Xr.Results}" SelectionChanged="OnPick">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type xr:EntryRow}">
              <DockPanel ToolTip="{Binding Tip}" Background="Transparent">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Where}" FontSize="10.5" Foreground="{StaticResource B.Info}" FontFamily="{StaticResource Font.Mono}" Margin="6,0,0,0" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding Kind}" FontSize="10.5" Foreground="{StaticResource B.TextDim}" Margin="6,0,0,0" />
                <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <WrapPanel DockPanel.Dock="Bottom" Margin="8,4,8,4">
      <TextBlock Style="{StaticResource Small}" Text="{DynamicResource Xr.PType}" Margin="0,0,4,4" ToolTip="{DynamicResource Tip.Xr.PType}" />
      <TextBox x:Name="PTypeBox" Style="{StaticResource Box.Num}" Width="110" Margin="0,0,8,4" ToolTip="{DynamicResource Tip.Xr.PType}" />
      <TextBlock Style="{StaticResource Small}" Text="{DynamicResource Xr.Variant}" Margin="0,0,4,4" ToolTip="{DynamicResource Tip.Xr.Variant}" />
      <ComboBox x:Name="VariantBox" Width="170" Margin="0,0,8,4" ToolTip="{DynamicResource Tip.Xr.Variant}" SelectionChanged="OnVariant" />
      <Button x:Name="ImportButton" Style="{StaticResource Btn.Accent}" Content="{DynamicResource Xr.Import}" ToolTip="{DynamicResource Tip.Xr.Import}" Click="OnImport" Margin="0,0,4,4" />
      <Button x:Name="SubstButton" Content="{DynamicResource Xr.ToSubst}" ToolTip="{DynamicResource Tip.Xr.ToSubst}" Click="OnToSubst" Margin="0,0,4,4" />
    </WrapPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock x:Name="EmptyText" Style="{StaticResource T.Dim}" TextWrapping="Wrap" Margin="12,10" />
        <ItemsControl x:Name="DetailList" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type xr:DetailRow}">
              <Grid>
                <Border x:Name="Head" Background="{StaticResource B.BgRaised}" BorderBrush="{StaticResource B.LineSubtle}" BorderThickness="0,1" Height="24" Padding="10,0" Visibility="Collapsed">
                  <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Tip}" />
                </Border>
                <Grid x:Name="Pair" Margin="10,2" ToolTip="{Binding Tip}" Background="Transparent">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Label}" Style="{StaticResource T.Dim}" FontSize="11" TextWrapping="Wrap" Margin="0,0,8,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11" FontFamily="{StaticResource Font.Mono}" TextWrapping="Wrap"
                             Foreground="{Binding Brush, Converter={StaticResource Brush}}" />
                </Grid>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Header}" Value="True">
                  <Setter TargetName="Head" Property="Visibility" Value="Visible" />
                  <Setter TargetName="Pair" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
