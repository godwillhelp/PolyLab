<UserControl x:Class="Pfx.App.Views.SlicerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tx="clr-namespace:Pfx.App.Textures">
  <UserControl.Resources>
    <Style TargetType="TextBlock" BasedOn="{StaticResource T.Base}" />
    <Style x:Key="Small" TargetType="TextBlock" BasedOn="{StaticResource T.Dim}">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource Box.Num}">
      <Setter Property="Width" Value="44" />
      <Setter Property="Margin" Value="3,0" />
      <EventSetter Event="KeyDown" Handler="OnFieldKey" />
      <EventSetter Event="LostKeyboardFocus" Handler="OnFieldLost" />
    </Style>
    <Style x:Key="Seg" TargetType="ToggleButton" BasedOn="{StaticResource Btn.Seg}">
      <Setter Property="Margin" Value="0,0,-1,0" />
    </Style>
  </UserControl.Resources>

  <DockPanel Background="{StaticResource B.BgPanel}">
    <Border DockPanel.Dock="Top" Background="{StaticResource B.BgRaised}" BorderBrush="{StaticResource B.LineSubtle}" BorderThickness="0,0,0,1" Padding="6,3">
      <WrapPanel VerticalAlignment="Center">
        <TextBlock x:Name="TargetText" Style="{StaticResource T.Hi}" FontSize="11" MaxWidth="170" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="2,0,8,0" />
        <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
          <ToggleButton x:Name="ViewChecker" Style="{StaticResource Seg}" Content="{DynamicResource Slicer.ViewChecker}" ToolTip="{DynamicResource Tip.SlicerViewChecker}" Tag="Checker" Click="OnView" />
          <ToggleButton x:Name="ViewBlack" Style="{StaticResource Seg}" Content="{DynamicResource Slicer.ViewBlack}" ToolTip="{DynamicResource Tip.SlicerViewBlack}" Tag="Black" Click="OnView" />
          <ToggleButton x:Name="ViewAlpha" Style="{StaticResource Seg}" Content="{DynamicResource Slicer.ViewAlpha}" ToolTip="{DynamicResource Tip.SlicerViewAlpha}" Tag="Alpha" Click="OnView" />
        </StackPanel>
        <TextBlock Style="{StaticResource Small}" Text="{DynamicResource Slicer.Grid}" ToolTip="{DynamicResource Tip.SlicerGrid}" />
        <TextBox x:Name="TileUBox" Style="{StaticResource Field}" ToolTip="{DynamicResource Tip.SlicerTileU}" />
        <TextBlock Style="{StaticResource Small}" Text="×" ToolTip="{DynamicResource Tip.SlicerGrid}" />
        <TextBox x:Name="TileVBox" Style="{StaticResource Field}" ToolTip="{DynamicResource Tip.SlicerTileV}" />
        <TextBlock x:Name="FramePx" Style="{StaticResource Small}" FontFamily="{StaticResource Font.Mono}" Margin="4,0,10,0" ToolTip="{DynamicResource Tip.SlicerFramePx}" />
        <TextBlock Style="{StaticResource Small}" Text="{DynamicResource Slicer.Mip}" ToolTip="{DynamicResource Tip.SlicerMip}" Margin="0,0,4,0" />
        <ComboBox x:Name="MipBox" Width="96" ToolTip="{DynamicResource Tip.SlicerMip}" SelectionChanged="OnMip" Margin="0,0,10,0" />
        <ToggleButton x:Name="NumbersButton" Style="{StaticResource Btn.Seg}" Content="#" ToolTip="{DynamicResource Tip.SlicerNumbers}" Click="OnNumbers" />
      </WrapPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{StaticResource B.BgPanel}" BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" Padding="6,3">
      <DockPanel>
        <StackPanel x:Name="SampleRow" DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center" />
        <StackPanel VerticalAlignment="Center">
          <WrapPanel>
            <ToggleButton x:Name="PlayButton" Style="{StaticResource Btn.Seg}" ToolTip="{DynamicResource Tip.SlicerPlay}" Click="OnPlay" Margin="0,0,8,0" />
            <TextBlock Style="{StaticResource Small}" Text="{DynamicResource Slicer.Fps}" ToolTip="{DynamicResource Tip.SlicerFps}" />
            <TextBox x:Name="FpsBox" Style="{StaticResource Field}" Width="52" ToolTip="{DynamicResource Tip.SlicerFps}" Margin="4,0,8,0" />
            <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
              <ToggleButton x:Name="OnceButton" Style="{StaticResource Seg}" Content="{DynamicResource Slicer.Once}" ToolTip="{DynamicResource Tip.SlicerOnce}" Tag="AnimOnce" Click="OnFlag" />
              <ToggleButton x:Name="RandomButton" Style="{StaticResource Seg}" Content="{DynamicResource Slicer.Random}" ToolTip="{DynamicResource Tip.SlicerRandom}" Tag="RandomFrame" Click="OnFlag" />
              <ToggleButton x:Name="ByAnimButton" Style="{StaticResource Seg}" Content="{DynamicResource Slicer.ByAnim}" ToolTip="{DynamicResource Tip.SlicerByAnim}" Tag="LifetimeByAnim" Click="OnFlag" />
            </StackPanel>
            <TextBlock Style="{StaticResource Small}" Text="{DynamicResource Slicer.Speed}" ToolTip="{DynamicResource Tip.SlicerSpeed}" Margin="0,0,4,0" />
            <StackPanel x:Name="SpeedRow" Orientation="Horizontal" />
          </WrapPanel>
          <TextBlock x:Name="PlayInfo" Style="{StaticResource Small}" Foreground="{StaticResource B.Text}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Right" Width="318" BorderBrush="{StaticResource B.LineSubtle}" BorderThickness="1,0,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Width="150" Margin="6,4,6,4" VerticalAlignment="Top">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource Small}" Text="{DynamicResource Slicer.Centre}" ToolTip="{DynamicResource Tip.SlicerCentre}" Margin="0,0,4,0" />
            <TextBox x:Name="CenterXBox" Grid.Column="1" Style="{StaticResource Field}" Width="Auto" ToolTip="{DynamicResource Tip.SlicerCenterX}" Margin="1" />
            <TextBox x:Name="CenterYBox" Grid.Column="2" Style="{StaticResource Field}" Width="Auto" ToolTip="{DynamicResource Tip.SlicerCenterY}" Margin="1" />
            <TextBlock Grid.Row="1" Style="{StaticResource Small}" Text="{DynamicResource Slicer.Scale}" ToolTip="{DynamicResource Tip.SlicerScale}" Margin="0,0,4,0" />
            <TextBox x:Name="ScaleXBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}" Width="Auto" ToolTip="{DynamicResource Tip.SlicerScaleX}" Margin="1" />
            <TextBox x:Name="ScaleYBox" Grid.Row="1" Grid.Column="2" Style="{StaticResource Field}" Width="Auto" ToolTip="{DynamicResource Tip.SlicerScaleY}" Margin="1" />
          </Grid>
          <TextBlock x:Name="MetresText" Style="{StaticResource Small}" FontFamily="{StaticResource Font.Mono}" TextTrimming="CharacterEllipsis" Margin="0,3,0,3" ToolTip="{DynamicResource Tip.SlicerMetres}" />
          <StackPanel Orientation="Horizontal">
            <Button x:Name="FileButton" Style="{StaticResource Btn.Icon}" Width="24" Height="24" ToolTip="{DynamicResource Tip.SlicerToFile}" Click="OnPivotFile" Margin="0,0,4,0">
              <Path Data="{StaticResource Ic.Undo}" Style="{StaticResource Ico.Small}" />
            </Button>
            <Button x:Name="DefaultButton" Style="{StaticResource Btn.Icon}" Width="24" Height="24" ToolTip="{DynamicResource Tip.SlicerDefault}" Click="OnPivotDefault">
              <Path Data="{StaticResource Ic.Reset}" Style="{StaticResource Ico.Small}" />
            </Button>
          </StackPanel>
        </StackPanel>
        <tx:SpriteCanvas x:Name="Sprite" ToolTip="{DynamicResource Tip.SlicerSprite}" />
      </DockPanel>
    </Border>

    <Grid>
      <tx:SheetCanvas x:Name="Sheet" ToolTip="{DynamicResource Tip.SlicerSheet}" />
      <TextBlock x:Name="EmptyText" Style="{StaticResource T.Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="12" IsHitTestVisible="False" />
    </Grid>
  </DockPanel>
</UserControl>
