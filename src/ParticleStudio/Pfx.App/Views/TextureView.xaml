<UserControl x:Class="Pfx.App.Views.TextureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tx="clr-namespace:Pfx.App.Textures"
             xmlns:c="clr-namespace:Pfx.App.Controls">
  <UserControl.Resources>
    <c:ThemeBrush x:Key="Brush" />
    <Style TargetType="TextBlock" BasedOn="{StaticResource T.Base}" />
  </UserControl.Resources>
  <DockPanel Background="{StaticResource B.BgPanel}">
    <WrapPanel DockPanel.Dock="Bottom" Margin="8,4,8,6">
      <Button x:Name="ToBuilderButton" Content="{DynamicResource Tex.ToBuilder}" ToolTip="{DynamicResource Tip.TexToBuilder}" Click="OnToBuilder" Margin="0,0,4,4" />
      <Button x:Name="ReloadButton" Content="{DynamicResource Tex.Reload}" ToolTip="{DynamicResource Tip.TexReload}" Click="OnReload" Margin="0,0,4,4" />
    </WrapPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock x:Name="EmptyText" Style="{StaticResource T.Dim}" TextWrapping="Wrap" Margin="12,10" />
        <ItemsControl x:Name="RowList" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type tx:InfoRow}">
              <Grid>
                <Border x:Name="Head" Background="{StaticResource B.BgRaised}" BorderBrush="{StaticResource B.LineSubtle}" BorderThickness="0,1" Height="25" Padding="12,0" Visibility="Collapsed">
                  <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="{Binding Label}" />
                </Border>
                <Grid x:Name="Pair" Margin="12,3" ToolTip="{Binding Tip}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="118" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Label}" Style="{StaticResource T.Dim}" FontSize="11" TextWrapping="Wrap" Margin="0,0,8,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11" FontFamily="{StaticResource Font.Mono}" TextWrapping="Wrap"
                             Foreground="{Binding Brush, Converter={StaticResource Brush}}" />
                </Grid>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Header}" Value="True">
                  <Setter TargetName="Head" Property="Visibility" Value="Visible" />
                  <Setter TargetName="Pair" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
