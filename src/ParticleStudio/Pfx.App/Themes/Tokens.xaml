<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">
  <!-- Palette of spec 5.3, built from #161B1F. Views use only these keys, never literal colours. -->
  <Color x:Key="C.BgDeep">#0E1215</Color>
  <Color x:Key="C.BgBase">#161B1F</Color>
  <Color x:Key="C.BgPanel">#1B2126</Color>
  <Color x:Key="C.BgRaised">#212930</Color>
  <Color x:Key="C.BgInput">#10151A</Color>
  <Color x:Key="C.BgHover">#27313A</Color>
  <Color x:Key="C.BgSelected">#1E3A44</Color>
  <Color x:Key="C.LineSubtle">#262E35</Color>
  <Color x:Key="C.Line">#313B44</Color>
  <Color x:Key="C.LineStrong">#43505B</Color>
  <Color x:Key="C.TextHi">#E8EEF2</Color>
  <Color x:Key="C.Text">#C3CDD4</Color>
  <Color x:Key="C.TextDim">#8494A0</Color>
  <Color x:Key="C.TextOff">#55626C</Color>
  <Color x:Key="C.Accent">#2EC4D6</Color>
  <Color x:Key="C.AccentHover">#5AD6E4</Color>
  <Color x:Key="C.AccentPress">#1E9FB0</Color>
  <Color x:Key="C.AccentSoft">#292EC4D6</Color>
  <Color x:Key="C.Key">#F0A73A</Color>
  <Color x:Key="C.Path">#D45BE0</Color>
  <Color x:Key="C.Ok">#46C485</Color>
  <Color x:Key="C.Warn">#E8B640</Color>
  <Color x:Key="C.Err">#E5534B</Color>
  <Color x:Key="C.ErrSoft">#29E5534B</Color>
  <Color x:Key="C.Info">#4B9BF5</Color>
  <Color x:Key="C.AxisX">#E5534B</Color>
  <Color x:Key="C.AxisY">#46C485</Color>
  <Color x:Key="C.AxisZ">#4B8EF5</Color>
  <Color x:Key="C.CurveR">#F0645A</Color>
  <Color x:Key="C.CurveG">#52CC8A</Color>
  <Color x:Key="C.CurveB">#5A9BF5</Color>
  <Color x:Key="C.CurveA">#D9E0E5</Color>
  <Color x:Key="C.CurveSize">#F0A73A</Color>
  <Color x:Key="C.CurveRot">#B48CF0</Color>
  <Color x:Key="C.Shadow">#99000000</Color>
  <Color x:Key="C.Transparent">#00000000</Color>

  <SolidColorBrush x:Key="B.BgDeep" Color="{StaticResource C.BgDeep}" />
  <SolidColorBrush x:Key="B.BgBase" Color="{StaticResource C.BgBase}" />
  <SolidColorBrush x:Key="B.BgPanel" Color="{StaticResource C.BgPanel}" />
  <SolidColorBrush x:Key="B.BgRaised" Color="{StaticResource C.BgRaised}" />
  <SolidColorBrush x:Key="B.BgInput" Color="{StaticResource C.BgInput}" />
  <SolidColorBrush x:Key="B.BgHover" Color="{StaticResource C.BgHover}" />
  <SolidColorBrush x:Key="B.BgSelected" Color="{StaticResource C.BgSelected}" />
  <SolidColorBrush x:Key="B.LineSubtle" Color="{StaticResource C.LineSubtle}" />
  <SolidColorBrush x:Key="B.Line" Color="{StaticResource C.Line}" />
  <SolidColorBrush x:Key="B.LineStrong" Color="{StaticResource C.LineStrong}" />
  <SolidColorBrush x:Key="B.TextHi" Color="{StaticResource C.TextHi}" />
  <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Text}" />
  <SolidColorBrush x:Key="B.TextDim" Color="{StaticResource C.TextDim}" />
  <SolidColorBrush x:Key="B.TextOff" Color="{StaticResource C.TextOff}" />
  <SolidColorBrush x:Key="B.Accent" Color="{StaticResource C.Accent}" />
  <SolidColorBrush x:Key="B.AccentHover" Color="{StaticResource C.AccentHover}" />
  <SolidColorBrush x:Key="B.AccentPress" Color="{StaticResource C.AccentPress}" />
  <SolidColorBrush x:Key="B.AccentSoft" Color="{StaticResource C.AccentSoft}" />
  <SolidColorBrush x:Key="B.Key" Color="{StaticResource C.Key}" />
  <SolidColorBrush x:Key="B.Path" Color="{StaticResource C.Path}" />
  <SolidColorBrush x:Key="B.Ok" Color="{StaticResource C.Ok}" />
  <SolidColorBrush x:Key="B.Warn" Color="{StaticResource C.Warn}" />
  <SolidColorBrush x:Key="B.Err" Color="{StaticResource C.Err}" />
  <SolidColorBrush x:Key="B.ErrSoft" Color="{StaticResource C.ErrSoft}" />
  <SolidColorBrush x:Key="B.Info" Color="{StaticResource C.Info}" />
  <SolidColorBrush x:Key="B.AxisX" Color="{StaticResource C.AxisX}" />
  <SolidColorBrush x:Key="B.AxisY" Color="{StaticResource C.AxisY}" />
  <SolidColorBrush x:Key="B.AxisZ" Color="{StaticResource C.AxisZ}" />
  <SolidColorBrush x:Key="B.CurveR" Color="{StaticResource C.CurveR}" />
  <SolidColorBrush x:Key="B.CurveG" Color="{StaticResource C.CurveG}" />
  <SolidColorBrush x:Key="B.CurveB" Color="{StaticResource C.CurveB}" />
  <SolidColorBrush x:Key="B.CurveA" Color="{StaticResource C.CurveA}" />
  <SolidColorBrush x:Key="B.CurveSize" Color="{StaticResource C.CurveSize}" />
  <SolidColorBrush x:Key="B.CurveRot" Color="{StaticResource C.CurveRot}" />
  <SolidColorBrush x:Key="B.Transparent" Color="{StaticResource C.Transparent}" />

  <!-- 4 px corners on controls, 6 px on panels, 1 px borders, one soft shadow for popups (spec 5.3). -->
  <CornerRadius x:Key="R.Control">4</CornerRadius>
  <CornerRadius x:Key="R.Panel">6</CornerRadius>
  <s:Double x:Key="F.Ui">12</s:Double>
  <s:Double x:Key="F.Dense">11</s:Double>
  <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Mono">pack://application:,,,/Suite.Ui;component/Assets/Fonts/#JetBrains Mono</FontFamily>
  <DropShadowEffect x:Key="Fx.Popup" BlurRadius="16" ShadowDepth="4" Opacity="0.45" Color="{StaticResource C.Shadow}" />
</ResourceDictionary>
