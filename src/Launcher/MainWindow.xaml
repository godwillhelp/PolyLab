<Window x:Class="PolyLab.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:PolyLab.Ui.Controls;assembly=PolyLab.Ui"
        xmlns:l="clr-namespace:PolyLab.Launcher"
        Title="Poly Lab" Width="1240" Height="760" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource B.Bg}" FontFamily="{StaticResource F.Ui}" Foreground="{StaticResource B.Text}"
        UseLayoutRounding="True" Icon="pack://application:,,,/PolyLab;component/polylab.ico">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <Style x:Key="Banner" TargetType="Border">
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,13,16,14"/>
      <Setter Property="Background" Value="{StaticResource B.OkBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource B.Ok}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding BannerKind}" Value="warn">
          <Setter Property="Background" Value="{StaticResource B.WarnBg}"/>
          <Setter Property="BorderBrush" Value="{StaticResource B.Warn}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding BannerKind}" Value="err">
          <Setter Property="Background" Value="{StaticResource B.ErrBg}"/>
          <Setter Property="BorderBrush" Value="{StaticResource B.Err}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <l:Bar x:Key="Bar"/>
  </Window.Resources>

  <Grid x:Name="Root" ClipToBounds="True">
    <Image Source="pack://application:,,,/PolyLab.Ui;component/Assets/Photos/bg_build.jpg" Stretch="UniformToFill"
           HorizontalAlignment="Right" VerticalAlignment="Top"/>
    <Rectangle>
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#F2080909" Offset="0"/>
          <GradientStop Color="#C8080909" Offset="0.42"/>
          <GradientStop Color="#40080909" Offset="0.78"/>
          <GradientStop Color="#70080909" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <Rectangle>
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#E6080909" Offset="0"/>
          <GradientStop Color="#33080909" Offset="0.18"/>
          <GradientStop Color="#1A080909" Offset="0.6"/>
          <GradientStop Color="#F2080909" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <Rectangle Fill="{StaticResource B.Scan}" IsHitTestVisible="False"/>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="96"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="46"/>
      </Grid.RowDefinitions>

      <Grid Background="Transparent" MouseLeftButtonDown="OnDrag">
        <Rectangle Style="{StaticResource Sep}" VerticalAlignment="Bottom"/>
        <StackPanel Orientation="Horizontal" Margin="56,0,0,0" VerticalAlignment="Center">
          <Image Source="pack://application:,,,/PolyLab.Ui;component/Assets/Brand/polylab.png" Width="60" Height="60"
                 VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
            <TextBlock Text="POLY LAB" FontFamily="{StaticResource F.Stencil}" FontWeight="Black" FontSize="40" Foreground="#E4E0D4"
                       OpacityMask="{StaticResource B.Grunge}" Margin="0,-6,0,-4"/>
            <TextBlock Text="L  A  U  N  C  H  E  R" FontSize="13" Foreground="{StaticResource B.Text2}" Margin="1,0,0,0"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,56,16">
          <Button x:Name="NewsBtn" Style="{StaticResource Btn.Tab}" Command="{Binding NewsCmd}" VerticalAlignment="Center" Margin="0,0,14,0"
                  ToolTip="{DynamicResource News.Tip}">
            <Grid>
              <StackPanel Orientation="Horizontal">
                <c:Ico Kind="chat" Size="18" Margin="0,0,8,0" Hot="{Binding IsMouseOver, ElementName=NewsBtn}"/>
                <TextBlock Text="{DynamicResource News.Button}" FontSize="14"/>
              </StackPanel>
              <Border Background="{StaticResource B.Orange}" MinWidth="18" Height="18" Padding="4,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                      Margin="0,-11,-14,0" Visibility="{Binding HasUnread, Converter={StaticResource Vis}}" IsHitTestVisible="False">
                <TextBlock Text="{Binding UnreadText}" FontSize="11.5" FontWeight="Bold" Foreground="#141515" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
          </Button>
          <Button x:Name="LangBtn" Style="{StaticResource Btn.Tab}" Command="{Binding LangCmd}" VerticalAlignment="Center" ToolTip="{DynamicResource Menu.Lang}">
            <StackPanel Orientation="Horizontal">
              <c:Ico Kind="globe" Size="16" Margin="0,0,7,0" Hot="{Binding IsMouseOver, ElementName=LangBtn}"/>
              <TextBlock Text="{DynamicResource Lang.Code}" FontSize="14"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="56,28,56,0">
          <StackPanel>
            <TextBlock Text="{DynamicResource Tools.Caps}" Style="{StaticResource T.Caps}" Foreground="{StaticResource B.Accent}" FontSize="13"/>
            <TextBlock Text="{DynamicResource Tools.Title}" FontSize="34" Margin="0,4,0,0"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Border Style="{StaticResource Pill}" Background="#D0101111" Padding="10,6,12,7" Margin="0,0,12,0" VerticalAlignment="Center"
                    BorderBrush="{Binding GraftState, Converter={StaticResource KindBrush}}" ToolTip="{Binding GraftTip}"
                    Visibility="{Binding HasGraft, Converter={StaticResource Vis}}">
              <StackPanel Orientation="Horizontal">
                <c:Ico Size="15" StrokeThickness="2" Margin="0,0,8,0" Kind="{Binding GraftState, Converter={StaticResource KindIcon}}"
                       Foreground="{Binding GraftState, Converter={StaticResource KindBrush}}"/>
                <TextBlock Text="{Binding GraftText}" FontSize="13.5" VerticalAlignment="Center" Foreground="{StaticResource B.Text2}"/>
                <Button Style="{StaticResource Btn.Link}" FontSize="13.5" Margin="12,0,0,0" Command="{Binding GraftRetryCmd}"
                        Content="{DynamicResource Graft.Retry}" Visibility="{Binding GraftFailed, Converter={StaticResource Vis}}"/>
              </StackPanel>
            </Border>
            <Button x:Name="UpdBtn" Style="{StaticResource Btn.Dark}" Height="38" Command="{Binding CheckCmd}" ToolTip="{Binding FootTip}">
              <StackPanel Orientation="Horizontal">
                <Grid Width="17" Height="17" Margin="0,0,9,0">
                  <c:Ico Kind="refresh" Size="17" Hot="{Binding IsMouseOver, ElementName=UpdBtn}"
                         Visibility="{Binding Checking, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                  <c:Ico Kind="spinner" Size="17" Visibility="{Binding Checking, Converter={StaticResource Vis}}"/>
                </Grid>
                <TextBlock Text="{DynamicResource Upd.Check}" FontSize="15" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="56,12,56,0" Background="#E6141212" BorderBrush="{StaticResource B.Orange}" BorderThickness="1" Padding="16,7,8,7"
                Visibility="{Binding HasSelfUpdate, Converter={StaticResource Vis}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <c:Ico Kind="download" Size="20" Foreground="{StaticResource B.Orange}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap">
              <Run Text="{Binding SelfTitle, Mode=OneWay}" FontSize="16"/><Run Text="   "/><Run Text="{DynamicResource Self.Text}" FontSize="13.5" Foreground="{StaticResource B.Text2}"/>
            </TextBlock>
            <Button Grid.Column="2" x:Name="SelfBtn" Style="{StaticResource Btn.Sand}" Height="32" FontSize="15" VerticalAlignment="Center"
                    Command="{Binding OpenCmd}" CommandParameter="{Binding SelfUpdate.Release.HtmlUrl}">
              <StackPanel Orientation="Horizontal">
                <c:Ico Kind="ext" Size="15" Margin="0,0,9,0" Foreground="{StaticResource B.SandInk}"/>
                <TextBlock Text="{DynamicResource Self.Open}" Typography.Capitals="AllSmallCaps" FontWeight="Bold" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Grid.Column="3" x:Name="SelfClose" Style="{StaticResource Btn.Chrome}" Width="30" Height="30" Margin="8,0,0,0" VerticalAlignment="Center"
                    Command="{Binding SelfDismissCmd}" ToolTip="{DynamicResource Banner.Close}">
              <c:Ico Kind="close" Size="13" StrokeThickness="1.4" Hot="{Binding IsMouseOver, ElementName=SelfClose}"/>
            </Button>
          </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Banner}" Margin="56,12,56,0" Visibility="{Binding HasBanner, Converter={StaticResource Vis}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <c:Ico Size="22" StrokeThickness="2" VerticalAlignment="Top" Margin="0,1,0,0"
                   Kind="{Binding BannerKind, Converter={StaticResource KindIcon}}" Foreground="{Binding BannerKind, Converter={StaticResource KindBrush}}"/>
            <StackPanel Grid.Column="1" Margin="14,0,0,0">
              <TextBlock Text="{Binding BannerTitle}" FontSize="17" TextWrapping="Wrap" Foreground="{StaticResource B.Text}"/>
              <TextBlock Text="{Binding BannerText}" FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource B.Text2}" Margin="0,4,0,0"
                         Visibility="{Binding BannerText, Converter={StaticResource Vis}}"/>
            </StackPanel>
            <Button Grid.Column="2" x:Name="BanClose" Style="{StaticResource Btn.Chrome}" Width="30" Height="30" Margin="12,-4,-6,0" VerticalAlignment="Top"
                    Command="{Binding DismissCmd}" ToolTip="{DynamicResource Banner.Close}">
              <c:Ico Kind="close" Size="13" StrokeThickness="1.4" Hot="{Binding IsMouseOver, ElementName=BanClose}"/>
            </Button>
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="56,16,40,8">
          <ItemsControl ItemsSource="{Binding Tools}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="ContentPresenter">
                <Setter Property="Visibility" Value="{Binding Listed, Converter={StaticResource Vis}}"/>
              </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <ContentControl Style="{StaticResource Hud}" Width="310" Height="376" Margin="0,0,16,16">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="150"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="1,1,1,0" ClipToBounds="True">
                      <Image Source="{Binding Image, Converter={StaticResource PathImage}, ConverterParameter=660}" Stretch="UniformToFill"/>
                      <Rectangle>
                        <Rectangle.Fill>
                          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#330B0C0C" Offset="0"/>
                            <GradientStop Color="#550B0C0C" Offset="0.5"/>
                            <GradientStop Color="#F00F1010" Offset="1"/>
                          </LinearGradientBrush>
                        </Rectangle.Fill>
                      </Rectangle>
                      <Rectangle Fill="{StaticResource B.Scan}"/>
                      <TextBlock Text="{Binding Abbrev}" FontFamily="{StaticResource F.Stencil}" FontWeight="Black" FontSize="64" Foreground="#E4E0D4"
                                 OpacityMask="{StaticResource B.Grunge}" VerticalAlignment="Bottom" Margin="20,0,0,-4"/>
                      <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0" Background="#D0101111"
                              BorderBrush="{Binding StatusKind, Converter={StaticResource KindBrush}}">
                        <StackPanel Orientation="Horizontal">
                          <Ellipse Width="7" Height="7" Fill="{Binding StatusKind, Converter={StaticResource KindBrush}}" VerticalAlignment="Center" Margin="0,1,7,0"/>
                          <TextBlock Text="{Binding StatusText}" FontSize="12.5" Foreground="{Binding StatusKind, Converter={StaticResource KindBrush}}"/>
                        </StackPanel>
                      </Border>
                      <Border Style="{StaticResource Pill}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,14,0,0" Background="#D0101111"
                              BorderBrush="{StaticResource B.Warn}" Cursor="Help" ToolTip="{DynamicResource Tool.BetaTip}"
                              ToolTipService.InitialShowDelay="120" Visibility="{Binding Beta, Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal">
                          <Ellipse Width="7" Height="7" Fill="{StaticResource B.Warn}" VerticalAlignment="Center" Margin="0,1,7,0"/>
                          <TextBlock Text="{DynamicResource Tool.Beta}" FontSize="12.5" Foreground="{StaticResource B.Warn}"/>
                        </StackPanel>
                      </Border>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="20,10,20,0">
                      <TextBlock Text="{Binding Name}" FontSize="22" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Desc}" FontSize="13.5" Foreground="{StaticResource B.Text2}" TextWrapping="Wrap" Margin="0,6,0,0"
                                 MaxHeight="76" TextTrimming="CharacterEllipsis" LineHeight="19"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="20,0,20,16">
                      <Button Style="{StaticResource Btn.Sand}" Height="46" FontSize="17" Command="{Binding DataContext.LaunchCmd, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}" IsEnabled="{Binding CanLaunch}" Visibility="{Binding ShowLaunch, Converter={StaticResource Vis}}">
                        <Grid>
                          <StackPanel Orientation="Horizontal" Visibility="{Binding Running, Converter={StaticResource Vis}, ConverterParameter=!}">
                            <c:Ico Kind="play" Size="16" Margin="0,0,10,0" Foreground="{StaticResource B.SandInk}"/>
                            <TextBlock Text="{DynamicResource Tool.Launch}" Typography.Capitals="AllSmallCaps" FontWeight="Bold" VerticalAlignment="Center"/>
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" Visibility="{Binding Running, Converter={StaticResource Vis}}">
                            <c:Ico Kind="spinner" Size="16" Margin="0,0,10,0" Foreground="{StaticResource B.SandInk}"/>
                            <TextBlock Text="{DynamicResource Tool.Running}" Typography.Capitals="AllSmallCaps" FontWeight="Bold" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Grid>
                      </Button>
                      <Button Style="{StaticResource Btn.Sand}" Height="46" FontSize="17" Command="{Binding DataContext.InstallCmd, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}" Visibility="{Binding ShowInstall, Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal">
                          <c:Ico Kind="download" Size="17" Margin="0,0,10,0" Foreground="{StaticResource B.SandInk}"/>
                          <TextBlock Text="{Binding InstallText}" Typography.Capitals="AllSmallCaps" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Button>
                      <Grid Height="46" Visibility="{Binding Busy, Converter={StaticResource Vis}}">
                        <Border Background="#0E0F0F" BorderBrush="{StaticResource B.Line2}" BorderThickness="1"/>
                        <Border Background="{StaticResource B.Sand}" HorizontalAlignment="Left" Margin="1"
                                Width="{Binding Progress, Converter={StaticResource Bar}, ConverterParameter=266}"/>
                        <TextBlock Text="{DynamicResource Tool.Installing}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   FontSize="14" Foreground="{StaticResource B.Text}"/>
                      </Grid>
                      <Grid Height="46" Visibility="{Binding ShowStatusOnly, Converter={StaticResource Vis}}">
                        <Border Background="#0E0F0F" BorderBrush="{StaticResource B.Line}" BorderThickness="1"/>
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   FontSize="14" Foreground="{StaticResource B.Dim}"/>
                      </Grid>
                      <Grid Margin="0,9,0,0" Height="18">
                        <TextBlock Text="{Binding VersionText}" FontFamily="{StaticResource F.Mono}" FontSize="11" Foreground="{StaticResource B.Dim}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                          <Button Style="{StaticResource Btn.Link}" FontSize="12.5" Margin="0,0,14,0" Content="{Binding LaunchOldText}"
                                  Command="{Binding DataContext.LaunchCmd, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                  Visibility="{Binding ShowLaunchOld, Converter={StaticResource Vis}}"/>
                          <Button Style="{StaticResource Btn.Link}" FontSize="12.5" Content="{DynamicResource Tool.Remove}"
                                  Command="{Binding DataContext.RemoveCmd, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                  Visibility="{Binding ShowRemove, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Grid>
                </ContentControl>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <Grid Grid.Row="2" Margin="56,0,56,0">
        <Rectangle Style="{StaticResource Sep}" VerticalAlignment="Top"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent" ToolTip="{Binding FootTip}">
          <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding FootKind, Converter={StaticResource KindBrush}}"/>
          <TextBlock Text="{Binding FootText}" FontSize="12.5" Foreground="{StaticResource B.Dim}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource Foot.Photo}" FontSize="11.5" Foreground="#4E4D48" Margin="0,0,18,0" ToolTip="{DynamicResource Foot.PhotoAll}"/>
          <TextBlock Text="{Binding AppVersionText}" FontSize="12" Foreground="{StaticResource B.Dim}" FontFamily="{StaticResource F.Mono}"/>
        </StackPanel>
      </Grid>
    </Grid>

    <!-- Release notes of the Poly Lab repo: read-only feed that slides in from the right over the page -->
    <Grid Margin="0,96,0,0" Visibility="{Binding NewsOpen, Converter={StaticResource Vis}}">
      <Rectangle Fill="#99050606" MouseLeftButtonDown="OnNewsBackdrop"/>
      <Border x:Name="NewsPanel" HorizontalAlignment="Right" Width="470" Background="#FA0D0E0E" BorderBrush="{StaticResource B.Line2}" BorderThickness="1,0,0,0">
        <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
        <Border.Style>
          <Style TargetType="Border">
            <Style.Triggers>
              <DataTrigger Binding="{Binding NewsOpen}" Value="True">
                <DataTrigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X" From="60" To="0" Duration="0:0:0.22" EasingFunction="{StaticResource Ease}"/>
                      <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                    </Storyboard>
                  </BeginStoryboard>
                </DataTrigger.EnterActions>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="22,18,14,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Source="pack://application:,,,/PolyLab.Ui;component/Assets/Brand/polylab.png" Width="40" Height="40"
                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource News.Title}" FontSize="19"/>
              <TextBlock Text="{DynamicResource News.Sub}" FontSize="12.5" Foreground="{StaticResource B.Dim}" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Grid.Column="2" x:Name="NewsX" Style="{StaticResource Btn.Chrome}" Width="34" Height="34" VerticalAlignment="Top"
                    Command="{Binding NewsCloseCmd}" ToolTip="{DynamicResource News.Close}">
              <c:Ico Kind="close" Size="14" StrokeThickness="1.4" Hot="{Binding IsMouseOver, ElementName=NewsX}"/>
            </Button>
          </Grid>
          <Rectangle DockPanel.Dock="Top" Style="{StaticResource Sep}"/>

          <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" Padding="22,12,22,14">
            <StackPanel Orientation="Horizontal">
              <c:Ico Kind="news" Size="14" Foreground="{StaticResource B.Dim}" Margin="0,0,8,0"/>
              <TextBlock Text="{DynamicResource News.ReadOnly}" FontSize="12.5" Foreground="{StaticResource B.Dim}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <Grid>
            <ScrollViewer x:Name="NewsScroll" VerticalScrollBarVisibility="Auto" Padding="18,14,18,8">
              <ItemsControl ItemsSource="{Binding News}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,14">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Image Source="pack://application:,,,/PolyLab.Ui;component/Assets/Brand/polylab.png" Width="30" Height="30" VerticalAlignment="Top" Margin="0,2,0,0"
                             RenderOptions.BitmapScalingMode="HighQuality"/>
                      <Border x:Name="Bubble" Grid.Column="1" Margin="8,0,0,0" Background="#161818" BorderBrush="{StaticResource B.Line}" BorderThickness="1" Padding="14,10,14,9">
                        <StackPanel>
                          <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" BorderBrush="{Binding Kind, Converter={StaticResource KindBrush}}" Padding="6,0,6,1">
                              <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="{Binding Kind, Converter={StaticResource KindBrush}}"/>
                            </Border>
                            <TextBlock Text="Poly Lab" FontSize="13" FontWeight="Bold" Foreground="{StaticResource B.Orange}" VerticalAlignment="Center"/>
                          </DockPanel>
                          <TextBlock Text="{Binding Title}" FontSize="16.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
                          <TextBlock Text="{Binding Body}" FontSize="14" Foreground="{StaticResource B.Text2}" TextWrapping="Wrap" LineHeight="20" Margin="0,4,0,0"
                                     Visibility="{Binding HasBody, Converter={StaticResource Vis}}"/>
                          <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Left" Style="{StaticResource Btn.Link}" FontSize="12" Content="GitHub"
                                    Command="{Binding DataContext.OpenCmd, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Page}"/>
                            <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource F.Mono}" FontSize="10.5" Foreground="{StaticResource B.Dim}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                          </DockPanel>
                        </StackPanel>
                      </Border>
                    </Grid>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsNew}" Value="True">
                        <Setter TargetName="Bubble" Property="BorderBrush" Value="{StaticResource B.Orange}"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding NewsEmpty, Converter={StaticResource Vis}}">
              <c:Ico Kind="news" Size="40" Foreground="{StaticResource B.Dim}" StrokeThickness="1.3"/>
              <TextBlock Text="{DynamicResource News.Empty}" FontSize="15" Foreground="{StaticResource B.Text2}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
            <Border VerticalAlignment="Top" Margin="18,12,18,0" Style="{StaticResource Pill}" BorderBrush="{StaticResource B.Warn}" Background="#E0151616" Padding="10,6"
                    Visibility="{Binding NewsStale, Converter={StaticResource Vis}}">
              <TextBlock Text="{DynamicResource News.Stale}" FontSize="12.5" Foreground="{StaticResource B.Warn}" TextWrapping="Wrap"/>
            </Border>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>

    <c:HeaderParticles Height="96" VerticalAlignment="Top" IsHitTestVisible="False">
      <c:HeaderParticles.OpacityMask>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#FF000000" Offset="0"/>
          <GradientStop Color="#FF000000" Offset="0.84"/>
          <GradientStop Color="#00000000" Offset="1"/>
        </LinearGradientBrush>
      </c:HeaderParticles.OpacityMask>
    </c:HeaderParticles>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
      <Button x:Name="WMin" Style="{StaticResource Btn.Win}" Click="OnMin" ToolTip="{DynamicResource Win.Min}">
        <c:Ico Kind="minus" Size="16" StrokeThickness="1.4" Hot="{Binding IsMouseOver, ElementName=WMin}"/>
      </Button>
      <Button x:Name="WMax" Style="{StaticResource Btn.Win}" Click="OnMax">
        <c:Ico x:Name="WMaxIco" Kind="square" Size="16" StrokeThickness="1.4"/>
      </Button>
      <Button x:Name="WClose" Style="{StaticResource Btn.WinClose}" Click="OnClose" ToolTip="{DynamicResource Win.Close}">
        <c:Ico Kind="close" Size="16" StrokeThickness="1.4"/>
      </Button>
    </StackPanel>
  </Grid>
</Window>
