<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NDZ_PBOGPacker</AssemblyName>
    <RootNamespace>NDZ.PBOGPacker</RootNamespace>
    <Version>0.1.2</Version>
    <Product>NDZ PBOG Packer</Product>
    <Description>PBO &amp; GRAFT Packer for DayZ Modifications</Description>
    <Company>NDZ</Company>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
    <Resource Include="Assets\Fonts\*.otf" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Art\*.png" />
    <Resource Include="Assets\Photos\*.jpg" />
    <Resource Include="Assets\Photos\credits.json" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\Brand\*.png" />
  </ItemGroup>

</Project>
