<UserControl x:Class="PolyLab.PBOGPacker.Views.WorkshopDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PolyLab.PBOGPacker.Controls">
  <UserControl.Resources>
    <Style x:Key="BareItem" TargetType="ListBoxItem">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PanelHead" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Rectangle Fill="{StaticResource B.Overlay}"/>
    <Border x:Name="Dlg" DataContext="{Binding Workshop}" MaxWidth="1180" MaxHeight="780" Margin="40,28"
            Background="#FA121313" BorderBrush="{StaticResource B.Line2}" BorderThickness="1" TextElement.FontFamily="{StaticResource F.Ui}">
      <Border.Effect>
        <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.7" Color="Black"/>
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="26,18,10,4">
          <Button ToolTip="{DynamicResource Tip.Close}" DockPanel.Dock="Right" Style="{StaticResource Btn.Close}" Command="{Binding CloseCmd}" VerticalAlignment="Top">
            <c:Ico Kind="close" Size="12"/>
          </Button>
          <StackPanel>
            <TextBlock Text="{DynamicResource Wm.Title}" FontSize="26"/>
            <TextBlock Text="{Binding Sub}" Style="{StaticResource T.Mono}" FontSize="12" Foreground="{StaticResource B.Dim}" Margin="0,4,0,0"/>
          </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="26,8,26,10">
          <DockPanel>
            <TextBlock Text="{DynamicResource Wm.Source}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Command="{Binding RefreshCmd}" Margin="18,0,0,0" x:Name="Rf"
                    ToolTip="{DynamicResource Wm.RefreshTip}">
              <StackPanel Orientation="Horizontal">
                <c:Ico Kind="refresh" Size="14" Margin="0,0,6,0" Hot="{Binding IsMouseOver, ElementName=Rf}"/>
                <TextBlock Text="{DynamicResource Wm.Refresh}"/>
              </StackPanel>
            </Button>
            <Button ToolTip="{DynamicResource Tip.WsChange}" DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Command="{Binding BrowseCmd}" Margin="14,0,0,0" x:Name="Chg">
              <StackPanel Orientation="Horizontal">
                <c:Ico Kind="folder" Size="15" Margin="0,0,6,0" Hot="{Binding IsMouseOver, ElementName=Chg}"/>
                <TextBlock Text="{DynamicResource Wm.Change}"/>
              </StackPanel>
            </Button>
            <TextBlock Text="{Binding WorkshopDir}" Style="{StaticResource T.Mono}" FontSize="12" Foreground="{StaticResource B.Text2}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding WorkshopDir}"/>
          </DockPanel>
          <Border Margin="0,10,0,0" Padding="12,8" BorderBrush="{StaticResource B.Err}" BorderThickness="1" Background="{StaticResource B.ErrBg}"
                  Visibility="{Binding HasError, Converter={StaticResource Vis}}">
            <DockPanel>
              <c:Ico Kind="warn" Size="16" Foreground="{StaticResource B.Err}" Margin="0,0,10,0"/>
              <TextBlock Text="{Binding Error}" FontSize="13.5" Foreground="{StaticResource B.Text}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
          <Border Margin="0,10,0,0" Padding="12,8" BorderBrush="{StaticResource B.Err}" BorderThickness="1" Background="{StaticResource B.ErrBg}"
                  Visibility="{Binding ScriptBusy, Converter={StaticResource Vis}}">
            <DockPanel>
              <c:Ico Kind="warn" Size="16" Foreground="{StaticResource B.Err}" Margin="0,0,10,0"/>
              <TextBlock Text="{DynamicResource Wm.Busy}" FontSize="13.5" Foreground="{StaticResource B.Text}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
          <Border Margin="0,10,0,0" Padding="12,8" BorderBrush="{StaticResource B.Warn}" BorderThickness="1"
                  Visibility="{Binding HasWarning, Converter={StaticResource Vis}}">
            <DockPanel>
              <c:Ico Kind="warn" Size="16" Foreground="{StaticResource B.Warn}" Margin="0,0,10,0"/>
              <TextBlock Text="{Binding Warning}" FontSize="13.5" Foreground="{StaticResource B.Text2}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
          <TextBlock Text="{DynamicResource Wm.ServerUp}" FontSize="13" Foreground="{StaticResource B.Warn}" TextWrapping="Wrap" Margin="0,8,0,0"
                     Visibility="{Binding ServerUp, Converter={StaticResource Vis}}"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="26,0,26,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- Available workshop mods -->
          <ContentControl Style="{StaticResource Hud}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <DockPanel Margin="16,12,10,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Command="{Binding FolderCmd}" x:Name="Fld"
                        ToolTip="{DynamicResource Wm.FolderTip}" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <c:Ico Kind="plus" Size="13" Margin="0,0,6,0" Hot="{Binding IsMouseOver, ElementName=Fld}"/>
                    <TextBlock Text="{DynamicResource Wm.Folder}"/>
                  </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" Margin="1,0,0,0">
                  <RadioButton ToolTip="{DynamicResource Tip.WsSource}" Style="{StaticResource Seg}" GroupName="wsrc" Content="{Binding WorkshopTab}"
                               IsChecked="{Binding Source, Converter={StaticResource Eq}, ConverterParameter=ws}"/>
                  <RadioButton Style="{StaticResource Seg}" GroupName="wsrc" Content="{Binding LocalTab}" ToolTip="{DynamicResource Wm.SrcLocalTip}"
                               IsChecked="{Binding Source, Converter={StaticResource Eq}, ConverterParameter=local}"/>
                </StackPanel>
              </DockPanel>
              <Grid Grid.Row="1" Margin="16,0,16,10">
                <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="13,0,4,0" Height="32" FontSize="14"/>
                <c:Ico Kind="search" Size="15" Foreground="{StaticResource B.Dim}" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/>
                <TextBlock Text="{DynamicResource Wm.Search}" FontSize="14" Foreground="{StaticResource B.Dim}" VerticalAlignment="Center" Margin="31,0,0,0"
                           IsHitTestVisible="False" Visibility="{Binding Search, Converter={StaticResource Vis}, ConverterParameter=!}"/>
              </Grid>
              <Rectangle Grid.Row="2" Style="{StaticResource Sep}" VerticalAlignment="Top"/>
              <ListBox Grid.Row="2" Style="{StaticResource PlainList}" Foreground="{StaticResource B.Text}" ItemsSource="{Binding SourceView}" ItemContainerStyle="{StaticResource BareItem}"
                       VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" Margin="0,1,0,0" Padding="6,4">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border x:Name="row" Background="Transparent" Padding="10,6,4,6">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" ToolTip="{Binding Path}">
                          <TextBlock x:Name="nm" Text="{Binding Name}" FontSize="15" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Sub}" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{StaticResource B.Dim}" Margin="0,1,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource Btn.Chrome}" Width="30" Height="30" Margin="8,0,0,0"
                                Command="{Binding DataContext.OpenCmd, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                ToolTip="{Binding FolderTip}">
                          <c:Ico Kind="folder" Size="14"/>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource Btn.Chrome}" Width="34" Height="30" Margin="4,0,0,0"
                                Command="{Binding DataContext.AddCmd, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                ToolTip="{Binding DataContext.AddTip, RelativeSource={RelativeSource AncestorType=ListBox}}" Visibility="{Binding IsQueued, Converter={StaticResource Vis}, ConverterParameter=!}">
                          <c:Ico Kind="plus" Size="16" StrokeThickness="2" Foreground="{StaticResource B.Accent}"/>
                        </Button>
                        <Border Grid.Column="2" Background="Transparent" Width="34" Height="30" Margin="4,0,0,0" ToolTip="{DynamicResource Wm.InQueue}"
                                Visibility="{Binding IsQueued, Converter={StaticResource Vis}}">
                          <c:Ico Kind="check" Size="15" StrokeThickness="2.2" Foreground="{StaticResource B.Ok}" AnimateIn="False"/>
                        </Border>
                      </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                      <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                        <Setter TargetName="row" Property="Background" Value="#14FFFFFF"/>
                      </Trigger>
                      <DataTrigger Binding="{Binding IsQueued}" Value="True">
                        <Setter TargetName="nm" Property="Foreground" Value="{StaticResource B.Dim}"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Grid.Row="2" Text="{DynamicResource Wm.NoMatch}" FontSize="14" Foreground="{StaticResource B.Dim}" HorizontalAlignment="Center" Margin="0,30,0,0"
                         Visibility="{Binding NoMatch, Converter={StaticResource Vis}}"/>
              <TextBlock Grid.Row="2" Text="{DynamicResource Wm.NoWorkshop}" FontSize="14" Foreground="{StaticResource B.Warn}" TextWrapping="Wrap" TextAlignment="Center"
                         Margin="30,30,30,0" Visibility="{Binding NoWorkshop, Converter={StaticResource Vis}}"/>
              <TextBlock Grid.Row="2" Text="{DynamicResource Wm.NoLocal}" FontSize="14" Foreground="{StaticResource B.Dim}" TextWrapping="Wrap" TextAlignment="Center"
                         Margin="30,30,30,0" Visibility="{Binding NoLocal, Converter={StaticResource Vis}}"/>
              <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0" Visibility="{Binding IsLoading, Converter={StaticResource Vis}}">
                <c:Ico Kind="spinner" Size="16" Margin="0,0,8,0"/>
                <TextBlock Text="{DynamicResource Wm.Loading}" FontSize="14" Foreground="{StaticResource B.Dim}"/>
              </StackPanel>
            </Grid>
          </ContentControl>

          <!-- Load order -->
          <ContentControl Grid.Column="2" Style="{StaticResource Hud}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <DockPanel Margin="16,12,10,8">
                <Button ToolTip="{DynamicResource Tip.WsClear}" DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Command="{Binding ClearCmd}" x:Name="Clr">
                  <StackPanel Orientation="Horizontal">
                    <c:Ico Kind="close" Size="12" Margin="0,0,6,0" Hot="{Binding IsMouseOver, ElementName=Clr}"/>
                    <TextBlock Text="{DynamicResource Wm.Clear}"/>
                  </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" Margin="1,0,0,0">
                  <RadioButton Style="{StaticResource Seg}" GroupName="wdst" Content="{Binding ClientTab}" ToolTip="{DynamicResource Wm.TabClientTip}"
                               IsChecked="{Binding Target, Converter={StaticResource Eq}, ConverterParameter=mod}"/>
                  <RadioButton Style="{StaticResource Seg}" GroupName="wdst" Content="{Binding ServerTab}" ToolTip="{DynamicResource Wm.TabServerTip}"
                               IsChecked="{Binding Target, Converter={StaticResource Eq}, ConverterParameter=server}"/>
                </StackPanel>
              </DockPanel>
              <TextBlock Grid.Row="1" Text="{Binding QueueHint}" FontSize="12.5" Foreground="{StaticResource B.Dim}" TextWrapping="Wrap" Margin="16,0,16,10"/>
              <Rectangle Grid.Row="2" Style="{StaticResource Sep}" VerticalAlignment="Top"/>
              <ListBox x:Name="QueueList" Grid.Row="2" Style="{StaticResource PlainList}" Foreground="{StaticResource B.Text}" ItemsSource="{Binding ActiveQueue}" ItemContainerStyle="{StaticResource BareItem}"
                       Margin="0,1,0,0" Padding="6,4" AllowDrop="True"
                       PreviewMouseLeftButtonDown="OnQueueDown" PreviewMouseMove="OnQueueMove" DragOver="OnQueueDragOver" Drop="OnQueueDrop">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border x:Name="row" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="4,5,4,5" Cursor="SizeAll">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="22"/>
                          <ColumnDefinition Width="30"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <c:Ico Kind="grip" Size="14" Foreground="{StaticResource B.Dim}" AnimateIn="False"/>
                        <TextBlock Grid.Column="1" Text="{Binding Number}" Style="{StaticResource T.Mono}" FontSize="12" Foreground="{StaticResource B.Orange}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" ToolTip="{Binding Full}">
                          <TextBlock Text="{Binding Name}" FontSize="15" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Text}" Style="{StaticResource T.Mono}" FontSize="10.5" Foreground="{StaticResource B.Dim}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="3" BorderThickness="1" Padding="6,1" Margin="8,0,4,0" VerticalAlignment="Center"
                                BorderBrush="{Binding KindBrush, Converter={StaticResource KindBrush}}">
                          <TextBlock Text="{Binding KindText}" FontSize="11.5" Foreground="{Binding KindBrush, Converter={StaticResource KindBrush}}"/>
                        </Border>
                        <Button Grid.Column="4" Style="{StaticResource Btn.Chrome}" Width="30" Height="28" Cursor="Hand"
                                Command="{Binding DataContext.OpenCmd, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                ToolTip="{Binding FolderTip}">
                          <c:Ico Kind="folder" Size="14"/>
                        </Button>
                        <Button Grid.Column="5" Style="{StaticResource Btn.Chrome}" Width="30" Height="28" Cursor="Hand"
                                Command="{Binding DataContext.SwapCmd, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                ToolTip="{Binding DataContext.SwapTip, RelativeSource={RelativeSource AncestorType=ListBox}}">
                          <c:Ico Kind="{Binding DataContext.SwapIcon, RelativeSource={RelativeSource AncestorType=ListBox}}" Size="14"/>
                        </Button>
                        <Button Grid.Column="6" Style="{StaticResource Btn.Chrome}" Width="30" Height="28" Cursor="Hand"
                                Command="{Binding DataContext.RemoveCmd, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                ToolTip="{DynamicResource Wm.RemoveTip}">
                          <c:Ico Kind="close" Size="12"/>
                        </Button>
                      </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                      <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                        <Setter TargetName="row" Property="Background" Value="#14FFFFFF"/>
                      </Trigger>
                      <DataTrigger Binding="{Binding IsDragging}" Value="True">
                        <Setter TargetName="row" Property="Background" Value="#26D8C9A3"/>
                        <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30,0" Visibility="{Binding QueueEmpty, Converter={StaticResource Vis}}">
                <c:Ico Kind="mods" Size="40" StrokeThickness="1.2" Foreground="{StaticResource B.Dim}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding EmptyText}" FontSize="14" Foreground="{StaticResource B.Dim}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>
              </StackPanel>
            </Grid>
          </ContentControl>
        </Grid>

        <Border Grid.Row="3" Margin="0,14,0,0" Background="#0C0D0D" BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0">
          <Grid Margin="26,12,22,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0">
              <TextBlock Text="{DynamicResource Wm.Preview}" FontSize="13" Foreground="{StaticResource B.Text2}"/>
              <TextBox Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="62" VerticalScrollBarVisibility="Auto"
                       FontFamily="{StaticResource F.Mono}" FontSize="11.5" Foreground="{StaticResource B.Accent}" Margin="0,5,0,0" Padding="8,4"/>
              <TextBlock Text="{DynamicResource Wm.KeysNote}" FontSize="12.5" Foreground="{StaticResource B.Dim}" TextWrapping="Wrap" Margin="0,6,0,0"
                         Visibility="{Binding HasSaveError, Converter={StaticResource Vis}, ConverterParameter=!}"/>
              <TextBlock Text="{Binding SaveError}" FontSize="13" Foreground="{StaticResource B.Err}" TextWrapping="Wrap" Margin="0,6,0,0"
                         Visibility="{Binding HasSaveError, Converter={StaticResource Vis}}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
              <Button Style="{StaticResource Btn.Link}" Command="{Binding CloseCmd}" Margin="0,0,22,0">
                <TextBlock Text="{DynamicResource Act.Cancel}"/>
              </Button>
              <Button ToolTip="{DynamicResource Tip.WsSave}" Style="{StaticResource Btn.Sand}" Command="{Binding SaveCmd}" x:Name="Sv">
                <StackPanel Orientation="Horizontal">
                  <c:Ico Kind="spinner" Size="16" Foreground="{StaticResource B.SandInk}" Margin="0,0,8,0" Visibility="{Binding Saving, Converter={StaticResource Vis}}"/>
                  <c:Ico Kind="check" Size="16" StrokeThickness="2" Foreground="{StaticResource B.SandInk}" Margin="0,0,8,0" AnimateIn="False"
                         Visibility="{Binding Saving, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                  <TextBlock Text="{Binding SaveText}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
