<UserControl x:Class="PolyLab.PBOGPacker.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PolyLab.PBOGPacker.Controls">
  <UserControl.Resources>
    <Style x:Key="SecLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
      <Setter Property="Margin" Value="0,26,0,10"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource B.Dim}"/>
      <Setter Property="Margin" Value="0,10,0,4"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{StaticResource B.Dim}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="17"/>
      <Setter Property="Margin" Value="0,5,0,0"/>
    </Style>
    <DataTemplate x:Key="ServerItem">
      <TextBlock Text="{Binding Name}"/>
    </DataTemplate>
  </UserControl.Resources>
  <Grid>
    <Rectangle Fill="#B30A0B0B"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="60,20,40,40" Width="660" HorizontalAlignment="Left">
        <DockPanel Margin="0,8,0,0">
          <Button ToolTip="{DynamicResource Tip.SaveSettings}" DockPanel.Dock="Right" Style="{StaticResource Btn.Sand}" Command="{Binding SaveSettingsCmd}" VerticalAlignment="Bottom" x:Name="Sv">
            <StackPanel Orientation="Horizontal">
              <c:Ico Kind="check" Size="17" Foreground="{StaticResource B.SandInk}" StrokeThickness="2" Margin="0,0,8,0" AnimateIn="False"/>
              <TextBlock Text="{DynamicResource Act.Save}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <TextBlock Text="{DynamicResource Set.Title}" Style="{StaticResource T.H1}"/>
        </DockPanel>

        <TextBlock Text="{DynamicResource Set.Lang}" Style="{StaticResource SecLabel}"/>
        <ComboBox Width="220" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding LangCode}">
          <ComboBoxItem Tag="en" Content="English"/>
          <ComboBoxItem Tag="ru" Content="Русский"/>
          <ComboBoxItem Tag="uk" Content="Українська"/>
        </ComboBox>

        <TextBlock Text="{DynamicResource Set.Tools}" Style="{StaticResource SecLabel}"/>
        <TextBlock Text="CMake" Style="{StaticResource FieldLabel}"/>
        <DockPanel>
          <Button ToolTip="{DynamicResource Tip.Browse}" DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Command="{Binding BrowseCmd}" CommandParameter="CMake" Margin="14,0,0,0">
            <StackPanel Orientation="Horizontal"><c:Ico Kind="folder" Size="16" Margin="0,0,6,0"/><TextBlock Text="{DynamicResource Act.Browse}"/></StackPanel>
          </Button>
          <TextBox Text="{Binding Settings.Tools.CMake}" FontFamily="{StaticResource F.Mono}" FontSize="12"/>
        </DockPanel>
        <TextBlock Text="graft.exe" Style="{StaticResource FieldLabel}"/>
        <DockPanel>
          <Button ToolTip="{DynamicResource Tip.Browse}" DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Command="{Binding BrowseCmd}" CommandParameter="Graft" Margin="14,0,0,0">
            <StackPanel Orientation="Horizontal"><c:Ico Kind="folder" Size="16" Margin="0,0,6,0"/><TextBlock Text="{DynamicResource Act.Browse}"/></StackPanel>
          </Button>
          <TextBox Text="{Binding Settings.Tools.Graft}" FontFamily="{StaticResource F.Mono}" FontSize="12"/>
        </DockPanel>
        <TextBlock Text="hid.dll" Style="{StaticResource FieldLabel}"/>
        <DockPanel>
          <Button ToolTip="{DynamicResource Tip.Browse}" DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Command="{Binding BrowseCmd}" CommandParameter="HostDll" Margin="14,0,0,0">
            <StackPanel Orientation="Horizontal"><c:Ico Kind="folder" Size="16" Margin="0,0,6,0"/><TextBlock Text="{DynamicResource Act.Browse}"/></StackPanel>
          </Button>
          <TextBox Text="{Binding Settings.Tools.HostDll}" FontFamily="{StaticResource F.Mono}" FontSize="12"/>
        </DockPanel>
        <TextBlock Text="keys" Style="{StaticResource FieldLabel}"/>
        <DockPanel>
          <Button ToolTip="{DynamicResource Tip.Browse}" DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Command="{Binding BrowseCmd}" CommandParameter="KeyDir" Margin="14,0,0,0">
            <StackPanel Orientation="Horizontal"><c:Ico Kind="folder" Size="16" Margin="0,0,6,0"/><TextBlock Text="{DynamicResource Act.Browse}"/></StackPanel>
          </Button>
          <TextBox Text="{Binding Settings.Tools.KeyDir}" FontFamily="{StaticResource F.Mono}" FontSize="12"/>
        </DockPanel>
        <TextBlock Text="{DynamicResource Set.Workshop}" Style="{StaticResource FieldLabel}"/>
        <DockPanel>
          <Button ToolTip="{DynamicResource Tip.Browse}" DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Command="{Binding BrowseCmd}" CommandParameter="WorkshopDir" Margin="14,0,0,0">
            <StackPanel Orientation="Horizontal"><c:Ico Kind="folder" Size="16" Margin="0,0,6,0"/><TextBlock Text="{DynamicResource Act.Browse}"/></StackPanel>
          </Button>
          <TextBox Text="{Binding Settings.WorkshopDir}" FontFamily="{StaticResource F.Mono}" FontSize="12"/>
        </DockPanel>
        <TextBlock Text="{Binding WorkshopAuto}" Style="{StaticResource Hint}"/>

        <TextBlock Text="{DynamicResource Set.Pack}" Style="{StaticResource SecLabel}"/>
        <TextBlock Text="{DynamicResource Set.ClientOut}" Style="{StaticResource FieldLabel}"/>
        <DockPanel>
          <Button ToolTip="{DynamicResource Tip.Browse}" DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Command="{Binding BrowseCmd}" CommandParameter="ClientOut" Margin="14,0,0,0">
            <StackPanel Orientation="Horizontal"><c:Ico Kind="folder" Size="16" Margin="0,0,6,0"/><TextBlock Text="{DynamicResource Act.Browse}"/></StackPanel>
          </Button>
          <TextBox Text="{Binding Settings.Pack.ClientOut}" FontFamily="{StaticResource F.Mono}" FontSize="12"/>
        </DockPanel>
        <TextBlock Text="{DynamicResource Set.ClientOutHint}" Style="{StaticResource Hint}"/>
        <TextBlock Text="{DynamicResource Set.ServerOut}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
        <DockPanel>
          <Button ToolTip="{DynamicResource Tip.Browse}" DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Command="{Binding BrowseCmd}" CommandParameter="ServerOut" Margin="14,0,0,0">
            <StackPanel Orientation="Horizontal"><c:Ico Kind="folder" Size="16" Margin="0,0,6,0"/><TextBlock Text="{DynamicResource Act.Browse}"/></StackPanel>
          </Button>
          <TextBox Text="{Binding Settings.Pack.ServerOut}" FontFamily="{StaticResource F.Mono}" FontSize="12"/>
        </DockPanel>
        <TextBlock Text="{DynamicResource Set.ServerOutHint}" Style="{StaticResource Hint}"/>
        <TextBlock Text="{DynamicResource Set.GraftedOut}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
        <DockPanel>
          <Button ToolTip="{DynamicResource Tip.Browse}" DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Command="{Binding BrowseCmd}" CommandParameter="GraftedOut" Margin="14,0,0,0">
            <StackPanel Orientation="Horizontal"><c:Ico Kind="folder" Size="16" Margin="0,0,6,0"/><TextBlock Text="{DynamicResource Act.Browse}"/></StackPanel>
          </Button>
          <TextBox Text="{Binding Settings.Pack.GraftedOut}" FontFamily="{StaticResource F.Mono}" FontSize="12"/>
        </DockPanel>
        <TextBlock Text="{DynamicResource Set.GraftedOutHint}" Style="{StaticResource Hint}"/>
        <TextBlock Text="{DynamicResource Set.OutEmpty}" Style="{StaticResource Hint}" Margin="0,12,0,0" Foreground="{StaticResource B.Text2}"/>
        <CheckBox ToolTip="{DynamicResource Set.RapifyHint}" Content="{DynamicResource Set.Rapify}" IsChecked="{Binding Settings.Pack.Rapify}" Margin="0,16,0,0"/>
        <TextBlock Text="{DynamicResource Set.RapifyHint}" Style="{StaticResource Hint}" Margin="27,4,0,0"/>
        <CheckBox ToolTip="{DynamicResource Set.AutoCppHint}" Content="{DynamicResource Set.AutoCpp}" IsChecked="{Binding Settings.Pack.AutoCpp}" Margin="0,12,0,0"/>
        <TextBlock Text="{DynamicResource Set.AutoCppHint}" Style="{StaticResource Hint}" Margin="27,4,0,0"/>

        <TextBlock Text="{DynamicResource Set.Defaults}" Style="{StaticResource SecLabel}"/>
        <CheckBox ToolTip="{DynamicResource Tip.OptSign}" Content="{DynamicResource Set.Sign}" IsChecked="{Binding Settings.Defaults.Sign}" Margin="0,4,0,6"/>
        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{DynamicResource Set.Preset}" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Settings.Defaults.Preset}"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="{DynamicResource Set.Key}" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding KeyTags}" SelectedItem="{Binding Settings.Defaults.Key}"/>
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Text="{DynamicResource Set.Server}" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding Servers}" SelectedValuePath="Id" SelectedValue="{Binding Settings.Defaults.Server}" ItemTemplate="{StaticResource ServerItem}"/>
          </StackPanel>
        </Grid>

        <TextBlock Text="{DynamicResource Set.After}" Style="{StaticResource SecLabel}"/>
        <CheckBox ToolTip="{DynamicResource Tip.AutoCopy}" Content="{DynamicResource Set.AutoCopy}" IsChecked="{Binding Settings.CopyLaunchLine}"/>

        <Rectangle Style="{StaticResource Sep}" Margin="0,30,0,12"/>
        <TextBlock Text="{Binding ConfigPath}" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{StaticResource B.Dim}"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
