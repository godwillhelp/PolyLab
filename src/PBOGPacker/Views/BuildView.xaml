<UserControl x:Class="PolyLab.PBOGPacker.Views.BuildView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PolyLab.PBOGPacker.Controls">
  <UserControl.Resources>
    <Style x:Key="TileHeadCaption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="#B9B5A9"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,10,0,0"/>
    </Style>
    <DataTemplate x:Key="LogLine">
      <Grid Margin="0,0,0,1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="84"/>
          <ColumnDefinition Width="128"/>
          <ColumnDefinition Width="18"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="bg" Grid.ColumnSpan="4" Margin="-12,0"/>
        <TextBlock Text="{Binding Time}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Dim}"/>
        <TextBlock Grid.Column="1" Text="{Binding Step}" FontSize="12.5" Foreground="{StaticResource B.Dim}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
        <c:Ico x:Name="ic" Grid.Column="2" Kind="{Binding Icon}" Size="12" StrokeThickness="2.2" VerticalAlignment="Top" Margin="0,2,0,0" AnimateIn="False"/>
        <TextBlock x:Name="tx" Grid.Column="3" Text="{Binding Text}" Style="{StaticResource T.Mono}" TextWrapping="Wrap"/>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Level}" Value="cmd">
          <Setter TargetName="tx" Property="Foreground" Value="{StaticResource B.Text}"/>
          <Setter TargetName="ic" Property="Foreground" Value="{StaticResource B.Dim}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="ok">
          <Setter TargetName="tx" Property="Foreground" Value="{StaticResource B.Ok}"/>
          <Setter TargetName="ic" Property="Foreground" Value="{StaticResource B.Ok}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="warn">
          <Setter TargetName="tx" Property="Foreground" Value="{StaticResource B.Warn}"/>
          <Setter TargetName="ic" Property="Foreground" Value="{StaticResource B.Warn}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="err">
          <Setter TargetName="tx" Property="Foreground" Value="{StaticResource B.Err}"/>
          <Setter TargetName="ic" Property="Foreground" Value="{StaticResource B.Err}"/>
          <Setter TargetName="bg" Property="Background" Value="{StaticResource B.ErrBg}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="30,22,30,26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Margin="0,0,0,14" BorderBrush="{StaticResource B.Err}" BorderThickness="1" Background="#E6120F0E">
      <Border.Visibility>
        <MultiBinding Converter="{StaticResource AllVis}">
          <Binding Path="ModEnvBad"/>
          <Binding Path="HasMod"/>
        </MultiBinding>
      </Border.Visibility>
      <Grid>
        <Border Background="{StaticResource B.Hazard}"/>
        <DockPanel Margin="14,8">
          <c:Ico Kind="warn" Size="18" Foreground="{StaticResource B.Err}" Margin="0,0,10,0"/>
          <Button ToolTip="{DynamicResource Tip.EnvFix}" DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Command="{Binding NavCmd}" CommandParameter="env" x:Name="BnFix">
            <StackPanel Orientation="Horizontal">
              <c:Ico Kind="wrench" Size="16" Margin="0,0,6,0" Hot="{Binding IsMouseOver, ElementName=BnFix}"/>
              <TextBlock Text="{DynamicResource Env.Fix}"/>
            </StackPanel>
          </Button>
          <TextBlock Text="{Binding ModEnvBanner}" FontSize="15" VerticalAlignment="Center"/>
        </DockPanel>
      </Grid>
    </Border>

    <UniformGrid Grid.Row="1" Columns="3" VerticalAlignment="Top">
      <UniformGrid.Visibility>
        <MultiBinding Converter="{StaticResource AllVis}">
          <Binding Path="ShowTiles"/>
          <Binding Path="HasMod"/>
        </MultiBinding>
      </UniformGrid.Visibility>

      <ContentControl Style="{StaticResource Hud}" Margin="0,0,10,0" x:Name="T1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Margin="1">
            <Image Source="/PBOG_Packer;component/Assets/Photos/st_build.jpg" Stretch="UniformToFill"/>
            <Rectangle>
              <Rectangle.Fill>
                <RadialGradientBrush RadiusX="0.55" RadiusY="0.75">
                  <GradientStop Color="#CC0B0C0C" Offset="0"/>
                  <GradientStop Color="#590B0C0C" Offset="1"/>
                </RadialGradientBrush>
              </Rectangle.Fill>
            </Rectangle>
            <StackPanel VerticalAlignment="Center">
              <c:Ico Kind="pack" Size="44" Foreground="#CFCABC" StrokeThickness="1.3" HorizontalAlignment="Center" Hot="{Binding IsMouseOver, ElementName=T1}"/>
              <TextBlock Text="{Binding CapBuild}" Style="{StaticResource TileHeadCaption}"/>
            </StackPanel>
            <Border Style="{StaticResource Pill}" Margin="10" VerticalAlignment="Top" Background="#CC0E0F0F"
                    BorderBrush="{Binding SelectedMod.BuildKind, Converter={StaticResource KindBrush}}">
              <c:Ico Kind="{Binding SelectedMod.BuildKind, Converter={StaticResource KindIcon}}" Size="14" StrokeThickness="2.2"
                     Foreground="{Binding SelectedMod.BuildKind, Converter={StaticResource KindBrush}}"/>
            </Border>
          </Grid>
          <Rectangle Grid.Row="1" Style="{StaticResource Sep}" VerticalAlignment="Top"/>
          <StackPanel Grid.Row="1" Margin="18,14,18,40">
            <TextBlock Text="{Binding SelectedMod.BuildTitle}" Style="{StaticResource T.H2}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding SelectedMod.BuildText}" FontSize="14" Foreground="{StaticResource B.Text2}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19"/>
          </StackPanel>
          <Button Grid.Row="1" Style="{StaticResource Btn.Chrome}" Command="{Binding JournalCmd}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" ToolTip="{DynamicResource Link.Journal}">
            <StackPanel Orientation="Horizontal"><c:Ico Kind="chevRight" Size="13" StrokeThickness="2"/><c:Ico Kind="chevRight" Size="13" StrokeThickness="2" Margin="-8,0,0,0"/></StackPanel>
          </Button>
        </Grid>
      </ContentControl>

      <ContentControl Style="{StaticResource Hud}" Margin="5,0" x:Name="T2">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Margin="1">
            <Image Source="/PBOG_Packer;component/Assets/Photos/st_sign.jpg" Stretch="UniformToFill"/>
            <Rectangle>
              <Rectangle.Fill>
                <RadialGradientBrush RadiusX="0.55" RadiusY="0.75">
                  <GradientStop Color="#CC0B0C0C" Offset="0"/>
                  <GradientStop Color="#590B0C0C" Offset="1"/>
                </RadialGradientBrush>
              </Rectangle.Fill>
            </Rectangle>
            <StackPanel VerticalAlignment="Center">
              <c:Ico Kind="shield" Size="44" Foreground="#CFCABC" StrokeThickness="1.3" HorizontalAlignment="Center" Hot="{Binding IsMouseOver, ElementName=T2}"/>
              <TextBlock Text="{Binding CapSign}" Style="{StaticResource TileHeadCaption}"/>
            </StackPanel>
            <Border Style="{StaticResource Pill}" Margin="10" VerticalAlignment="Top" Background="#CC0E0F0F"
                    BorderBrush="{Binding SelectedMod.SignKind, Converter={StaticResource KindBrush}}">
              <c:Ico Kind="{Binding SelectedMod.SignKind, Converter={StaticResource KindIcon}}" Size="14" StrokeThickness="2.2"
                     Foreground="{Binding SelectedMod.SignKind, Converter={StaticResource KindBrush}}"/>
            </Border>
          </Grid>
          <Rectangle Grid.Row="1" Style="{StaticResource Sep}" VerticalAlignment="Top"/>
          <StackPanel Grid.Row="1" Margin="18,14,18,40">
            <TextBlock Text="{Binding SelectedMod.SignTitle}" Style="{StaticResource T.H2}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding SelectedMod.SignText}" FontSize="14" Foreground="{StaticResource B.Text2}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19"/>
          </StackPanel>
          <Button ToolTip="{DynamicResource Tip.ToKeys}" Grid.Row="1" Style="{StaticResource Btn.Chrome}" Command="{Binding NavCmd}" CommandParameter="keys" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
            <StackPanel Orientation="Horizontal"><c:Ico Kind="chevRight" Size="13" StrokeThickness="2"/><c:Ico Kind="chevRight" Size="13" StrokeThickness="2" Margin="-8,0,0,0"/></StackPanel>
          </Button>
        </Grid>
      </ContentControl>

      <ContentControl Style="{StaticResource Hud}" Margin="10,0,0,0" x:Name="T3">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Margin="1">
            <Image Source="/PBOG_Packer;component/Assets/Photos/st_deploy.jpg" Stretch="UniformToFill"/>
            <Rectangle>
              <Rectangle.Fill>
                <RadialGradientBrush RadiusX="0.55" RadiusY="0.75">
                  <GradientStop Color="#CC0B0C0C" Offset="0"/>
                  <GradientStop Color="#590B0C0C" Offset="1"/>
                </RadialGradientBrush>
              </Rectangle.Fill>
            </Rectangle>
            <StackPanel VerticalAlignment="Center">
              <c:Ico Kind="deploy" Size="44" Foreground="#CFCABC" StrokeThickness="1.3" HorizontalAlignment="Center" Hot="{Binding IsMouseOver, ElementName=T3}"/>
              <TextBlock Text="{Binding CapDeploy}" Style="{StaticResource TileHeadCaption}"/>
            </StackPanel>
            <Border Style="{StaticResource Pill}" Margin="10" VerticalAlignment="Top" Background="#CC0E0F0F"
                    BorderBrush="{Binding SelectedMod.DeployKind, Converter={StaticResource KindBrush}}">
              <c:Ico Kind="{Binding SelectedMod.DeployKind, Converter={StaticResource KindIcon}}" Size="14" StrokeThickness="2.2"
                     Foreground="{Binding SelectedMod.DeployKind, Converter={StaticResource KindBrush}}"/>
            </Border>
          </Grid>
          <Rectangle Grid.Row="1" Style="{StaticResource Sep}" VerticalAlignment="Top"/>
          <StackPanel Grid.Row="1" Margin="18,14,18,40">
            <TextBlock Text="{Binding SelectedMod.DeployTitle}" Style="{StaticResource T.H2}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding SelectedMod.DeployText}" FontSize="14" Foreground="{StaticResource B.Text2}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19"/>
          </StackPanel>
          <Button ToolTip="{DynamicResource Tip.ToServers}" Grid.Row="1" Style="{StaticResource Btn.Chrome}" Command="{Binding NavCmd}" CommandParameter="servers" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
            <StackPanel Orientation="Horizontal"><c:Ico Kind="chevRight" Size="13" StrokeThickness="2"/><c:Ico Kind="chevRight" Size="13" StrokeThickness="2" Margin="-8,0,0,0"/></StackPanel>
          </Button>
        </Grid>
      </ContentControl>
    </UniformGrid>

    <Grid Grid.Row="1">
      <Grid.Visibility>
        <MultiBinding Converter="{StaticResource AllVis}">
          <Binding Path="ShowJournal"/>
          <Binding Path="HasMod"/>
        </MultiBinding>
      </Grid.Visibility>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="380"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <ContentControl Style="{StaticResource Hud}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Margin="18,14,14,12">
            <DockPanel>
              <Button ToolTip="{DynamicResource Tip.CloseJournal}" DockPanel.Dock="Right" Style="{StaticResource Btn.Chrome}" Command="{Binding JournalCmd}" Width="24" Height="24">
                <c:Ico Kind="close" Size="12"/>
              </Button>
              <TextBlock Text="{Binding CapRun}" FontSize="13" Foreground="{StaticResource B.Dim}" VerticalAlignment="Center"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
              <c:Ico Kind="{Binding RunKind, Converter={StaticResource KindIcon}}" Foreground="{Binding RunKind, Converter={StaticResource KindBrush}}" Size="18" StrokeThickness="2" Margin="0,0,8,0"/>
              <TextBlock Text="{Binding RunText}" FontSize="17" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource T.Mono}" FontSize="13" VerticalAlignment="Center" Margin="12,1,0,0"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding SegStates}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Height="5" Margin="0,0,3,0" ClipToBounds="True">
                    <Rectangle x:Name="r" Fill="{StaticResource B.Line2}"/>
                    <Rectangle x:Name="sw" Fill="{StaticResource B.Accent}" Width="24" HorizontalAlignment="Left" Visibility="Collapsed">
                      <Rectangle.RenderTransform><TranslateTransform/></Rectangle.RenderTransform>
                    </Rectangle>
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding}" Value="ok"><Setter TargetName="r" Property="Fill" Value="{StaticResource B.Ok}"/></DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="err"><Setter TargetName="r" Property="Fill" Value="{StaticResource B.Err}"/></DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="skip"><Setter TargetName="r" Property="Fill" Value="#2A2B29"/></DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="run">
                      <Setter TargetName="r" Property="Fill" Value="#3A3830"/>
                      <Setter TargetName="sw" Property="Visibility" Value="Visible"/>
                      <DataTrigger.EnterActions>
                        <BeginStoryboard>
                          <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="sw" Storyboard.TargetProperty="RenderTransform.X" From="-24" To="44" Duration="0:0:0.9"/>
                          </Storyboard>
                        </BeginStoryboard>
                      </DataTrigger.EnterActions>
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <Rectangle Grid.Row="1" Style="{StaticResource Sep}" VerticalAlignment="Top"/>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,1,0,0">
            <Grid>
              <Rectangle Width="1" Fill="{StaticResource B.Line2}" HorizontalAlignment="Left" Margin="43,26,0,26"/>
              <ItemsControl ItemsSource="{Binding Steps}" Margin="0,6">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <Button ToolTip="{DynamicResource Tip.StepToggle}" Command="{Binding DataContext.ToggleStepCmd, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                              Style="{StaticResource Btn.Menu}" Foreground="{StaticResource B.Text}" x:Name="row">
                        <Grid Margin="4,2,0,2">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="20"/>
                          </Grid.ColumnDefinitions>
                          <Grid Width="50" Height="36">
                            <Image Source="{Binding Image, Converter={StaticResource PathImage}, ConverterParameter=160}" Stretch="UniformToFill"/>
                            <Rectangle x:Name="dim" Fill="#8C101111"/>
                            <Border BorderThickness="1" BorderBrush="{Binding Kind, Converter={StaticResource KindBrush}}"/>
                            <Border Width="17" Height="17" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-6"
                                    Background="#141515" BorderThickness="1" BorderBrush="{Binding Kind, Converter={StaticResource KindBrush}}">
                              <c:Ico Kind="{Binding Kind, Converter={StaticResource KindIcon}}" Size="11" StrokeThickness="2.4"
                                     Foreground="{Binding Kind, Converter={StaticResource KindBrush}}"/>
                            </Border>
                          </Grid>
                          <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="tt" Text="{Binding Title}" FontSize="16"/>
                            <TextBlock Text="{Binding Tool}" Style="{StaticResource T.Mono}" FontSize="10.5" Foreground="{StaticResource B.Dim}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                          </StackPanel>
                          <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MsText}" Style="{StaticResource T.Mono}" FontSize="11" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="12" HorizontalAlignment="Right" Margin="0,2,0,0"
                                       Foreground="{Binding Kind, Converter={StaticResource KindBrush}}"/>
                          </StackPanel>
                          <c:Ico x:Name="chev" Grid.Column="3" Kind="chevDown" Size="14" Foreground="{StaticResource B.Dim}" HorizontalAlignment="Right" RenderTransformOrigin="0.5,0.5">
                            <c:Ico.LayoutTransform><RotateTransform/></c:Ico.LayoutTransform>
                          </c:Ico>
                        </Grid>
                      </Button>
                      <Border Margin="60,0,14,8" Background="{StaticResource B.Log}" BorderBrush="{StaticResource B.Line}" BorderThickness="1" Padding="10,8"
                              Visibility="{Binding IsOpen, Converter={StaticResource Vis}}">
                        <Grid>
                          <ItemsControl ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <TextBlock x:Name="l" Text="{Binding Text}" Style="{StaticResource T.Mono}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                <DataTemplate.Triggers>
                                  <DataTrigger Binding="{Binding Level}" Value="cmd"><Setter TargetName="l" Property="Foreground" Value="{StaticResource B.Text}"/></DataTrigger>
                                  <DataTrigger Binding="{Binding Level}" Value="ok"><Setter TargetName="l" Property="Foreground" Value="{StaticResource B.Ok}"/></DataTrigger>
                                  <DataTrigger Binding="{Binding Level}" Value="warn"><Setter TargetName="l" Property="Foreground" Value="{StaticResource B.Warn}"/></DataTrigger>
                                  <DataTrigger Binding="{Binding Level}" Value="err"><Setter TargetName="l" Property="Foreground" Value="{StaticResource B.Err}"/></DataTrigger>
                                </DataTemplate.Triggers>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Text="{DynamicResource Step.NoLog}" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{StaticResource B.Dim}"
                                     Visibility="{Binding Lines.Count, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                        </Grid>
                      </Border>
                    </StackPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsOpen}" Value="True">
                        <Setter TargetName="chev" Property="LayoutTransform">
                          <Setter.Value><RotateTransform Angle="180"/></Setter.Value>
                        </Setter>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Kind}" Value="off">
                        <Setter TargetName="tt" Property="Foreground" Value="{StaticResource B.Dim}"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Kind}" Value="skip">
                        <Setter TargetName="tt" Property="Foreground" Value="{StaticResource B.Dim}"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Kind}" Value="ok">
                        <Setter TargetName="dim" Property="Fill" Value="#33101111"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Kind}" Value="err">
                        <Setter TargetName="dim" Property="Fill" Value="#662A1612"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Kind}" Value="run">
                        <Setter TargetName="dim" Property="Fill" Value="#1A101111"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Kind}" Value="off">
                        <Setter TargetName="dim" Property="Fill" Value="#D9101111"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Kind}" Value="skip">
                        <Setter TargetName="dim" Property="Fill" Value="#D9101111"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </ScrollViewer>
        </Grid>
      </ContentControl>

      <ContentControl Grid.Column="2" Style="{StaticResource Hud}" Background="{StaticResource B.Log}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel Margin="16,10,10,10" LastChildFill="False">
            <Rectangle x:Name="Live" Width="8" Height="8" Fill="{Binding RunKind, Converter={StaticResource KindBrush}}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="{DynamicResource Log.Title}" FontSize="16" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <RadioButton ToolTip="{DynamicResource Tip.LogAll}" Style="{StaticResource Seg}" GroupName="lf" Content="{DynamicResource Log.All}"
                           IsChecked="{Binding LogFilter, Converter={StaticResource Eq}, ConverterParameter=all}"/>
              <RadioButton ToolTip="{DynamicResource Tip.LogWarn}" Style="{StaticResource Seg}" GroupName="lf"
                           IsChecked="{Binding LogFilter, Converter={StaticResource Eq}, ConverterParameter=warn}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{DynamicResource Log.Warn}"/>
                  <TextBlock Text="{Binding WarnCount}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Warn}" Margin="6,1,0,0"/>
                </StackPanel>
              </RadioButton>
              <RadioButton ToolTip="{DynamicResource Tip.LogErr}" Style="{StaticResource Seg}" GroupName="lf"
                           IsChecked="{Binding LogFilter, Converter={StaticResource Eq}, ConverterParameter=err}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{DynamicResource Log.Err}"/>
                  <TextBlock Text="{Binding ErrCount}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Err}" Margin="6,1,0,0"/>
                </StackPanel>
              </RadioButton>
              <CheckBox ToolTip="{DynamicResource Tip.LogAuto}" Content="{DynamicResource Log.Auto}" IsChecked="{Binding AutoScroll}" Margin="16,0,10,0" FontSize="14"/>
              <Button Style="{StaticResource Btn.Chrome}" Command="{Binding CopyLogCmd}" ToolTip="{DynamicResource Log.Copy}" x:Name="CpLog">
                <c:Ico Kind="copy" Size="16" Hot="{Binding IsMouseOver, ElementName=CpLog}"/>
              </Button>
            </StackPanel>
          </DockPanel>
          <Rectangle Grid.Row="1" Style="{StaticResource Sep}" VerticalAlignment="Top"/>
          <ListBox x:Name="LogList" Grid.Row="1" Style="{StaticResource PlainList}" ItemsSource="{Binding LogView}" ItemTemplate="{StaticResource LogLine}"
                   VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" Margin="0,1,0,0" Padding="16,8">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
          <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding LogEmpty, Converter={StaticResource Vis}}">
            <c:Ico Kind="terminal" Size="38" StrokeThickness="1.2" Foreground="{StaticResource B.Dim}" HorizontalAlignment="Center"/>
            <TextBlock Text="{DynamicResource Log.Empty}" FontSize="15" Foreground="{StaticResource B.Dim}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" Margin="0,12,0,0"/>
          </StackPanel>
          <DockPanel Grid.Row="2" Margin="16,6">
            <TextBlock Text="{Binding LinesText}" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{StaticResource B.Dim}"/>
            <TextBlock Text="UTF-8 · stdout + stderr" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{StaticResource B.Dim}" HorizontalAlignment="Right"/>
          </DockPanel>
        </Grid>
      </ContentControl>
    </Grid>

    <Grid Grid.Row="1" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="620">
      <StackPanel>
        <c:Ico Kind="mods" Size="64" StrokeThickness="1.1" Foreground="{StaticResource B.Accent}" HorizontalAlignment="Left" Hot="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}"/>
        <TextBlock Text="{DynamicResource Empty.Title}" FontSize="44" FontWeight="Black" Margin="0,18,0,0"/>
        <TextBlock Text="{DynamicResource Empty.Body}" FontSize="17" Foreground="{StaticResource B.Text2}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="24"/>
        <StackPanel Margin="0,24,0,0">
          <StackPanel.Resources>
            <Style TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
          </StackPanel.Resources>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><TextBlock Text="01" FontSize="22" Foreground="{StaticResource B.Dim}" Width="42"/><TextBlock Text="{DynamicResource Empty.S1}"/></StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><TextBlock Text="02" FontSize="22" Foreground="{StaticResource B.Dim}" Width="42"/><TextBlock Text="{DynamicResource Empty.S2}"/></StackPanel>
          <StackPanel Orientation="Horizontal"><TextBlock Text="03" FontSize="22" Foreground="{StaticResource B.Dim}" Width="42"/><TextBlock Text="{DynamicResource Empty.S3}"/></StackPanel>
        </StackPanel>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2" Margin="0,12,0,0" VerticalAlignment="Bottom" Visibility="{Binding HasMod, Converter={StaticResource Vis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Width="92" Height="92" Margin="0,0,20,4" VerticalAlignment="Bottom" Style="{StaticResource Btn.Base}"
              Visibility="{Binding SelectedMod.HasLogo, Converter={StaticResource Vis}}"
              Command="{Binding PickLogoCmd}" CommandParameter="{Binding SelectedMod}" ToolTip="{DynamicResource Logo.Hint}">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Image Source="{Binding SelectedMod.Logo, Converter={StaticResource PathImage}, ConverterParameter=200}" Stretch="UniformToFill"/>
              <Border BorderBrush="{StaticResource B.LineHi}" BorderThickness="1"/>
              <Path Data="M0,12 L0,0 L12,0" Stroke="{StaticResource B.Accent}" StrokeThickness="2" Margin="-4,-4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
              <Path Data="M0,0 L12,0 L12,12" Stroke="{StaticResource B.Accent}" StrokeThickness="2" Margin="0,-4,-4,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
              <Path Data="M0,0 L0,12 L12,12" Stroke="{StaticResource B.Accent}" StrokeThickness="2" Margin="-4,0,0,-4" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
              <Path Data="M12,0 L12,12 L0,12" Stroke="{StaticResource B.Accent}" StrokeThickness="2" Margin="0,0,-4,-4" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
            </Grid>
          </ControlTemplate>
        </Button.Template>
      </Button>
    <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
    <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" MaxHeight="112">
      <TextBlock Text="{Binding SelectedMod.NameUpper}" FontFamily="{StaticResource F.Stencil}" FontWeight="Black" FontSize="112"
                 OpacityMask="{StaticResource B.Grunge}" Margin="0,-22,0,-16">
        <TextBlock.Foreground>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E3DED0" Offset="0"/>
            <GradientStop Color="#9C978A" Offset="1"/>
          </LinearGradientBrush>
        </TextBlock.Foreground>
      </TextBlock>
    </Viewbox>
      <StackPanel Orientation="Horizontal" Margin="4,10,0,0">
        <TextBlock Text="{Binding SelectedMod.Version}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Orange}"/>
        <TextBlock Text="  ·  " Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Dim}"/>
        <TextBlock Text="{Binding SelectedMod.Modules}" Style="{StaticResource T.Mono}"/>
        <TextBlock Text="  ·  " Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Dim}"/>
        <TextBlock Text="{Binding SelectedMod.Path}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Dim}" ToolTip="{Binding SelectedMod.Path}"/>
      </StackPanel>
    </StackPanel>
    </Grid>

    <Grid Grid.Row="3" Margin="0,6,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,-10,6" Visibility="{Binding HasMod, Converter={StaticResource Vis}}">
          <StackPanel.Resources>
            <Style TargetType="c:Ico">
              <Setter Property="Size" Value="16"/>
              <Setter Property="Margin" Value="0,0,7,0"/>
              <Setter Property="Hot" Value="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource Btn.Tab}">
              <Setter Property="Margin" Value="4,0,0,0"/>
            </Style>
          </StackPanel.Resources>
          <Button ToolTip="{DynamicResource Tip.Server}" x:Name="SrvLink" Command="{Binding ServerMenuCmd}" c:Ui.Active="{Binding ServerMenuOpen}">
            <StackPanel Orientation="Horizontal">
              <c:Ico Kind="servers"/>
              <TextBlock Text="{DynamicResource Link.Server}"/>
              <TextBlock Text="{Binding ServerText, StringFormat=' ({0})'}" MaxWidth="170" TextTrimming="CharacterEllipsis"/>
              <c:Ico Kind="chevDown" Size="13" Margin="4,1,0,0"/>
            </StackPanel>
          </Button>
          <Button ToolTip="{DynamicResource Tip.Options}" x:Name="OptLink" Command="{Binding OptionsCmd}" c:Ui.Active="{Binding OptionsOpen}">
            <StackPanel Orientation="Horizontal">
              <c:Ico Kind="settings"/>
              <TextBlock Text="{DynamicResource Link.Options}"/>
              <c:Ico Kind="chevDown" Size="13" Margin="4,1,0,0"/>
            </StackPanel>
          </Button>
          <Button ToolTip="{Binding SelectedMod.DeployTip}" Command="{Binding DeployCmd}" c:Ui.Active="{Binding SelectedMod.IsBusy}">
            <StackPanel Orientation="Horizontal">
              <c:Ico Kind="deploy"/>
              <TextBlock Text="{DynamicResource Link.Deploy}"/>
            </StackPanel>
          </Button>
          <Button ToolTip="{DynamicResource Tip.Journal}" Command="{Binding JournalCmd}" c:Ui.Active="{Binding ShowJournal}">
            <StackPanel Orientation="Horizontal">
              <c:Ico Kind="terminal"/>
              <TextBlock Text="{DynamicResource Link.Journal}"/>
            </StackPanel>
          </Button>
          <Button ToolTip="{DynamicResource Tip.ModFolder}" Command="{Binding OpenCmd}" CommandParameter="{Binding SelectedMod.Path}">
            <StackPanel Orientation="Horizontal">
              <c:Ico Kind="folder"/>
              <TextBlock Text="{DynamicResource Link.Folder}"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <Popup IsOpen="{Binding ServerMenuOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=SrvLink}" Placement="Top" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-6">
          <Border Background="#F7141515" BorderBrush="{StaticResource B.Line2}" BorderThickness="1" Padding="0,6" MinWidth="300" TextElement.FontFamily="{StaticResource F.Ui}">
            <ItemsControl ItemsSource="{Binding Servers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource Btn.Menu}" Command="{Binding DataContext.SelectServerCmd, RelativeSource={RelativeSource AncestorType=Popup}}" CommandParameter="{Binding}">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}"/>
                      <TextBlock Text="{Binding Path}" Style="{StaticResource T.Mono}" FontSize="10.5" Foreground="{StaticResource B.Dim}"/>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </Popup>

        <Popup IsOpen="{Binding OptionsOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=OptLink}" Placement="Top" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-6">
          <Border Background="#F7141515" BorderBrush="{StaticResource B.Line2}" BorderThickness="1" Padding="18,14" Width="390" TextElement.FontFamily="{StaticResource F.Ui}">
            <StackPanel>
              <TextBlock Text="{DynamicResource Opt.Kind}" Style="{StaticResource T.Label}" Margin="0,0,0,8"/>
              <StackPanel Orientation="Horizontal" Margin="1,0,0,10" IsEnabled="{Binding IsIdle}">
                <RadioButton ToolTip="{DynamicResource Tip.KindClient}" Style="{StaticResource Seg}" GroupName="side" Content="{DynamicResource Opt.Client}" IsChecked="{Binding ModSide, Converter={StaticResource Eq}, ConverterParameter=client}"/>
                <RadioButton ToolTip="{DynamicResource Tip.KindServer}" Style="{StaticResource Seg}" GroupName="side" Content="{DynamicResource Opt.Server}" IsChecked="{Binding ModSide, Converter={StaticResource Eq}, ConverterParameter=server}"/>
              </StackPanel>
              <CheckBox ToolTip="{DynamicResource Tip.KindGrafted}" Content="{DynamicResource Opt.Grafted}" IsChecked="{Binding UseGrafted}" IsEnabled="{Binding GraftToggleEnabled}"/>
              <TextBlock Text="{DynamicResource Opt.GraftedNo}" FontSize="12" Foreground="{StaticResource B.Dim}" TextWrapping="Wrap" Margin="27,3,0,0"
                         Visibility="{Binding GraftNoProject, Converter={StaticResource Vis}}"/>
              <Button Style="{StaticResource Btn.Link}" Command="{Binding CreateCppCmd}" Margin="27,8,0,0" HorizontalAlignment="Left" x:Name="MkCpp"
                      ToolTip="{DynamicResource Tip.CreateCpp}" Visibility="{Binding SelectedMod.CanCreateCpp, Converter={StaticResource Vis}}">
                <StackPanel Orientation="Horizontal">
                  <c:Ico Kind="plus" Size="13" Margin="0,0,6,0" Hot="{Binding IsMouseOver, ElementName=MkCpp}"/>
                  <TextBlock Text="{DynamicResource Act.CreateCpp}"/>
                </StackPanel>
              </Button>
              <DockPanel Margin="27,6,0,0" Visibility="{Binding SelectedMod.CppDir, Converter={StaticResource Vis}}">
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Command="{Binding OpenCmd}" CommandParameter="{Binding SelectedMod.CppDir}"
                        ToolTip="{DynamicResource Tip.OpenCpp}" Margin="8,0,0,0" VerticalAlignment="Top">
                  <c:Ico Kind="folder" Size="14"/>
                </Button>
                <TextBlock FontSize="12" Foreground="{StaticResource B.Text2}" TextWrapping="Wrap">
                  <Run Text="{DynamicResource Opt.Cpp}"/> <Run Text="{Binding SelectedMod.CppDir, Mode=OneWay}" FontFamily="{StaticResource F.Mono}"/>
                </TextBlock>
              </DockPanel>

              <Rectangle Style="{StaticResource Sep}" Margin="0,14,0,12"/>
              <TextBlock Text="{DynamicResource Opt.Out}" Style="{StaticResource T.Label}" Margin="0,0,0,6"/>
              <TextBlock Text="{Binding DestText}" Style="{StaticResource T.Mono}" FontSize="11.5" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding DestHint}" FontSize="12" Foreground="{StaticResource B.Dim}" TextWrapping="Wrap" Margin="0,4,0,0"/>
              <!-- Wraps: the popup is narrow and "make it common for server mods" alone takes most of a row -->
              <WrapPanel Margin="0,2,0,0">
                <Button ToolTip="{DynamicResource Tip.OutPick}" Style="{StaticResource Btn.Link}" Command="{Binding PickOutCmd}" x:Name="OutPick" Margin="0,6,18,0">
                  <StackPanel Orientation="Horizontal"><c:Ico Kind="folder" Size="15" Margin="0,0,6,0" Hot="{Binding IsMouseOver, ElementName=OutPick}"/><TextBlock Text="{DynamicResource Opt.OutPick}"/></StackPanel>
                </Button>
                <Button ToolTip="{DynamicResource Tip.OutReset}" Style="{StaticResource Btn.Link}" Command="{Binding ResetOutCmd}" Margin="0,6,18,0" x:Name="OutReset"
                        Visibility="{Binding HasOutOverride, Converter={StaticResource Vis}}">
                  <StackPanel Orientation="Horizontal"><c:Ico Kind="refresh" Size="15" Margin="0,0,6,0" Hot="{Binding IsMouseOver, ElementName=OutReset}"/><TextBlock Text="{DynamicResource Opt.OutReset}"/></StackPanel>
                </Button>
                <Button ToolTip="{DynamicResource Tip.PickCommon}" Style="{StaticResource Btn.Link}" Command="{Binding PickCommonCmd}" x:Name="ComPick" Margin="0,6,18,0">
                  <StackPanel Orientation="Horizontal"><c:Ico Kind="folder" Size="15" Margin="0,0,6,0" Hot="{Binding IsMouseOver, ElementName=ComPick}"/><TextBlock Text="{Binding PickCommonText}"/></StackPanel>
                </Button>
                <Button ToolTip="{DynamicResource Tip.MakeCommon}" Style="{StaticResource Btn.Link}" Command="{Binding MakeCommonCmd}" Margin="0,6,18,0" x:Name="ComMake"
                        Visibility="{Binding HasOutOverride, Converter={StaticResource Vis}}">
                  <StackPanel Orientation="Horizontal"><c:Ico Kind="copy" Size="15" Margin="0,0,6,0" Hot="{Binding IsMouseOver, ElementName=ComMake}"/><TextBlock Text="{Binding MakeCommonText}"/></StackPanel>
                </Button>
              </WrapPanel>

              <Rectangle Style="{StaticResource Sep}" Margin="0,14,0,12"/>
              <TextBlock Text="{DynamicResource Opt.Key}" Style="{StaticResource T.Label}" Margin="0,0,0,8"/>
              <ItemsControl ItemsSource="{Binding KeyChoices}" Margin="1,0,0,0" IsEnabled="{Binding IsIdle}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <RadioButton ToolTip="{DynamicResource Tip.KeyTag}" Style="{StaticResource Seg}" GroupName="modkey" Content="{Binding Tag}" IsChecked="{Binding IsOn}" Margin="0,0,0,4"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{DynamicResource Opt.NoKeys}" FontSize="12.5" Foreground="{StaticResource B.Warn}" TextWrapping="Wrap"
                         Visibility="{Binding NoKeys, Converter={StaticResource Vis}}"/>

              <Rectangle Style="{StaticResource Sep}" Margin="0,12,0,12"/>
              <StackPanel Visibility="{Binding BuildsPlugin, Converter={StaticResource Vis}}">
                <TextBlock Text="{DynamicResource Opt.Preset}" Style="{StaticResource T.Label}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="1,0,0,14">
                  <RadioButton ToolTip="{DynamicResource Tip.Release}" Style="{StaticResource Seg}" GroupName="preset" Content="release" IsChecked="{Binding Preset, Converter={StaticResource Eq}, ConverterParameter=release}"/>
                  <RadioButton ToolTip="{DynamicResource Tip.Debug}" Style="{StaticResource Seg}" GroupName="preset" Content="debug" IsChecked="{Binding Preset, Converter={StaticResource Eq}, ConverterParameter=debug}"/>
                </StackPanel>
              </StackPanel>
              <CheckBox ToolTip="{DynamicResource Tip.OptSign}" Content="{DynamicResource Opt.Sign}" IsChecked="{Binding Sign}" Margin="0,0,0,10"/>
              <CheckBox ToolTip="{DynamicResource Tip.OptDeploy}" Content="{DynamicResource Opt.Deploy}" IsChecked="{Binding Deploy}"/>
              <CheckBox ToolTip="{DynamicResource Tip.OptHost}" Content="{DynamicResource Opt.Host}" IsChecked="{Binding Host}" Margin="0,10,0,0"
                        Visibility="{Binding IsGraftedMod, Converter={StaticResource Vis}}"/>
            </StackPanel>
          </Border>
        </Popup>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Border Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Line2}" BorderThickness="1" Width="340" Height="84" Padding="18,0"
                  Visibility="{Binding HasMod, Converter={StaticResource Vis}}" Margin="0,0,14,0">
            <Grid VerticalAlignment="Center">
              <Grid Visibility="{Binding IsRunning, Converter={StaticResource Vis}, ConverterParameter=!}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.Resources>
                  <Style TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,0,6,1"/></Style>
                </Grid.Resources>
                <TextBlock Text="{DynamicResource Info.Kind}" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="{Binding KindLine}" Foreground="{StaticResource B.Orange}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="1" Text="{DynamicResource Info.Key}" FontWeight="Bold"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding KeyText}" Foreground="{StaticResource B.Text2}"/>
                <TextBlock Grid.Row="2" Text="{DynamicResource Info.Server}" FontWeight="Bold"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ServerText}" Foreground="{StaticResource B.Text2}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="3" Text="{DynamicResource Info.Dest}" FontWeight="Bold"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DestShort}" ToolTip="{Binding DestText}" Foreground="{StaticResource B.Text2}"
                           FontFamily="{StaticResource F.Mono}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              </Grid>
              <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource Vis}}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding ElapsedText}" Style="{StaticResource T.Mono}" FontSize="13" Foreground="{StaticResource B.Text}"/>
                  <TextBlock Text="{Binding StepLine}" FontSize="15" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding SegStates}" Margin="0,12,0,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Rectangle x:Name="r" Height="8" Margin="0,0,3,0" Fill="{StaticResource B.Line2}"/>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding}" Value="ok"><Setter TargetName="r" Property="Fill" Value="{StaticResource B.Ok}"/></DataTrigger>
                        <DataTrigger Binding="{Binding}" Value="skip"><Setter TargetName="r" Property="Fill" Value="#2A2B29"/></DataTrigger>
                        <DataTrigger Binding="{Binding}" Value="run">
                          <Setter TargetName="r" Property="Fill" Value="{StaticResource B.Accent}"/>
                          <DataTrigger.EnterActions>
                            <BeginStoryboard>
                              <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetName="r" Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.5"/>
                              </Storyboard>
                            </BeginStoryboard>
                          </DataTrigger.EnterActions>
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding RunModLine}" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{StaticResource B.Dim}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </Border>

          <Grid>
            <Button ToolTip="{DynamicResource Tip.Build}" x:Name="BigBtn" Style="{StaticResource Btn.Big}" Command="{Binding BuildCmd}">
              <Button.Visibility>
                <MultiBinding Converter="{StaticResource AllVis}">
                  <Binding Path="HasMod"/>
                  <Binding Path="IsIdle"/>
                </MultiBinding>
              </Button.Visibility>
              <Grid Width="330" Height="84">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2">
                  <c:Ico Kind="pack" Size="36" StrokeThickness="1.8" Margin="0,0,16,0" Foreground="{StaticResource B.SandInk}" Hot="{Binding IsMouseOver, ElementName=BigBtn}"/>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Big.Build}" FontSize="34" Margin="0,-4,0,-6"/>
                    <TextBlock Text="{Binding BigSub}" FontSize="15" Foreground="#5C574B"/>
                  </StackPanel>
                </StackPanel>
                <TextBlock Text="Ctrl+B" FontFamily="{StaticResource F.Mono}" FontSize="10" Foreground="#7A7466" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,8"/>
              </Grid>
            </Button>
            <Button ToolTip="{DynamicResource Tip.AddMod}" x:Name="AddBig" Style="{StaticResource Btn.Big}" Command="{Binding AddModCmd}" Visibility="{Binding HasMod, Converter={StaticResource Vis}, ConverterParameter=!}">
              <Grid Width="330" Height="84">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2">
                  <c:Ico Kind="plus" Size="32" StrokeThickness="1.8" Margin="0,0,16,0" Foreground="{StaticResource B.SandInk}" Hot="{Binding IsMouseOver, ElementName=AddBig}"/>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Big.Add}" FontSize="34" Margin="0,-4,0,-6"/>
                    <TextBlock Text="{DynamicResource Big.AddSub}" FontSize="15" Foreground="#5C574B"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Button>
            <Button ToolTip="{Binding CancelTip}" Style="{StaticResource Btn.Hazard}" Command="{Binding CancelCmd}" Visibility="{Binding IsRunning, Converter={StaticResource Vis}}">
              <StackPanel Orientation="Horizontal">
                <c:Ico Kind="stop" Size="22" Foreground="{StaticResource B.Err}" Margin="0,0,14,0"/>
                <TextBlock Text="{DynamicResource Big.Cancel}" FontSize="30"/>
                <TextBlock Text="Esc" FontFamily="{StaticResource F.Mono}" FontSize="11" VerticalAlignment="Bottom" Margin="12,0,0,6" Opacity="0.7"/>
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
