<UserControl x:Class="PolyLab.PBOGPacker.Views.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PolyLab.PBOGPacker.Controls">
  <Grid>
    <Rectangle Fill="#A60A0B0B"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="40,28,40,40" MaxWidth="1100" HorizontalAlignment="Left">
        <DockPanel Margin="0,0,0,20">
          <Button ToolTip="{DynamicResource Tip.AddServer}" DockPanel.Dock="Right" Style="{StaticResource Btn.Dark}" VerticalAlignment="Bottom" x:Name="Add" Command="{Binding AddServerCmd}">
            <StackPanel Orientation="Horizontal">
              <c:Ico Kind="plus" Size="17" Margin="0,0,8,0" Hot="{Binding IsMouseOver, ElementName=Add}"/>
              <TextBlock Text="{DynamicResource Act.AddServer}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <StackPanel>
            <TextBlock Text="{DynamicResource Srv.Title}" Style="{StaticResource T.H1}"/>
            <TextBlock Text="{DynamicResource Srv.Sub}" Style="{StaticResource T.Label}" FontSize="15" Margin="0,4,0,0"/>
          </StackPanel>
        </DockPanel>

        <ItemsControl ItemsSource="{Binding Servers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ContentControl Style="{StaticResource Hud}" Margin="0,0,0,14">
                <Grid Margin="20,16,20,18">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <DockPanel>
                    <Grid Width="44" Height="44" DockPanel.Dock="Left">
                      <Image Source="/PBOG_Packer;component/Assets/Photos/st_host.jpg" Stretch="UniformToFill"/>
                      <Rectangle Fill="#660B0C0C"/>
                      <Border BorderBrush="{StaticResource B.Line2}" BorderThickness="1"/>
                      <c:Ico Kind="servers" Size="22" Foreground="#DCD8CC"/>
                    </Grid>
                    <StackPanel Margin="14,0,16,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="20" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Path}" Style="{StaticResource T.Mono}" FontSize="11.5" Foreground="{StaticResource B.Dim}"
                                 TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                    </StackPanel>
                  </DockPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn.Dark}" Height="34" FontSize="15" Margin="0,0,10,0" x:Name="Stop"
                            Command="{Binding DataContext.StopServerCmd, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            ToolTip="{Binding StopTip}" ToolTipService.ShowOnDisabled="True" Visibility="{Binding ShowStop, Converter={StaticResource Vis}}">
                      <StackPanel Orientation="Horizontal">
                        <c:Ico Kind="spinner" Size="16" Margin="0,0,8,0" Visibility="{Binding IsStopping, Converter={StaticResource Vis}}"/>
                        <c:Ico Kind="stop" Size="16" Margin="0,0,8,0" Foreground="{StaticResource B.Err}"
                               Visibility="{Binding IsStopping, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                        <TextBlock Text="{Binding StopText}" VerticalAlignment="Center">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding StopArmed}" Value="True">
                                  <Setter Property="Foreground" Value="{StaticResource B.Err}"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Dark}" Height="34" FontSize="15" Margin="0,0,10,0" x:Name="Launch"
                            Command="{Binding DataContext.LaunchServerCmd, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            ToolTip="{Binding LaunchTip}" ToolTipService.ShowOnDisabled="True" Visibility="{Binding ShowStop, Converter={StaticResource Vis}, ConverterParameter=!}">
                      <StackPanel Orientation="Horizontal">
                        <c:Ico Kind="spinner" Size="16" Margin="0,0,8,0" Visibility="{Binding IsStarting, Converter={StaticResource Vis}}"/>
                        <c:Ico Kind="play" Size="16" Margin="0,0,8,0" Foreground="{StaticResource B.Ok}" Hot="{Binding IsMouseOver, ElementName=Launch}"
                               Visibility="{Binding IsStarting, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                        <TextBlock Text="{DynamicResource Act.StartServer}" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Dark}" Height="34" FontSize="15" Margin="0,0,10,0" x:Name="Wsh"
                            Command="{Binding DataContext.OpenWorkshopCmd, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            ToolTip="{DynamicResource Wm.OpenTip}" ToolTipService.ShowOnDisabled="True">
                      <StackPanel Orientation="Horizontal">
                        <c:Ico Kind="mods" Size="16" Margin="0,0,8,0" Hot="{Binding IsMouseOver, ElementName=Wsh}"/>
                        <TextBlock Text="{DynamicResource Act.ConnectMods}" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Dark}" Height="34" FontSize="15" Margin="0,0,10,0" x:Name="Chk"
                            Command="{Binding DataContext.CheckGraftCmd, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            ToolTip="{DynamicResource Tip.CheckGraft}">
                      <StackPanel Orientation="Horizontal">
                        <c:Ico Kind="spinner" Size="16" Margin="0,0,8,0" Visibility="{Binding IsChecking, Converter={StaticResource Vis}}"/>
                        <c:Ico Kind="shield" Size="16" Margin="0,0,8,0" Hot="{Binding IsMouseOver, ElementName=Chk}"
                               Visibility="{Binding IsChecking, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                        <TextBlock Text="{DynamicResource Act.CheckGraft}" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Button ToolTip="{Binding InstallHostTip}" Style="{StaticResource Btn.Sand}" Height="34" FontSize="15" Margin="0,0,10,0"
                            Command="{Binding DataContext.InstallHostCmd, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            Visibility="{Binding CanInstallHost, Converter={StaticResource Vis}}">
                      <StackPanel Orientation="Horizontal">
                        <c:Ico Kind="spinner" Size="16" Foreground="{StaticResource B.SandInk}" Margin="0,0,8,0" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}"/>
                        <c:Ico Kind="cpu" Size="16" Foreground="{StaticResource B.SandInk}" Margin="0,0,8,0" Visibility="{Binding IsBusy, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                        <TextBlock Text="{Binding InstallHostText}" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                        <TextBlock Text="{DynamicResource Act.Installing}" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}"/>
                      </StackPanel>
                    </Button>
                    <Button ToolTip="{DynamicResource Tip.SrvFolder}" Style="{StaticResource Btn.Dark}" Height="34" FontSize="15"
                            Command="{Binding DataContext.OpenCmd, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Path}">
                      <StackPanel Orientation="Horizontal">
                        <c:Ico Kind="folder" Size="16" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource Link.Folder}" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>

                  <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="58,16,0,0">
                    <WrapPanel.Resources>
                      <Style TargetType="StackPanel">
                        <Setter Property="Orientation" Value="Horizontal"/>
                        <Setter Property="Margin" Value="0,0,34,6"/>
                        <Setter Property="MinHeight" Value="26"/>
                      </Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                      </Style>
                    </WrapPanel.Resources>
                    <StackPanel>
                      <TextBlock Text="{DynamicResource Srv.State}" FontSize="15" FontWeight="Bold" Margin="0,0,6,0"/>
                      <Ellipse Width="8" Height="8" Fill="{Binding StateKind, Converter={StaticResource KindBrush}}" VerticalAlignment="Center" Margin="0,1,6,0"/>
                      <TextBlock Text="{Binding StateText}" FontSize="15" Foreground="{Binding StateKind, Converter={StaticResource KindBrush}}"/>
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="{DynamicResource Srv.Bat}" FontSize="15" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding SelectedBat}" Style="{StaticResource T.Mono}" FontSize="13" Foreground="{StaticResource B.Text2}" VerticalAlignment="Center"
                                 Visibility="{Binding ManyScripts, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                      <ComboBox ItemsSource="{Binding Scripts}" SelectedItem="{Binding SelectedBat}" MinWidth="170" Height="26" Padding="8,0" VerticalContentAlignment="Center"
                                FontFamily="{StaticResource F.Mono}" FontSize="13" Visibility="{Binding ManyScripts, Converter={StaticResource Vis}}"/>
                      <TextBlock Text="{DynamicResource Srv.NoBat}" FontSize="15" Foreground="{StaticResource B.Warn}" VerticalAlignment="Center"
                                 Visibility="{Binding HasScripts, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="{DynamicResource Srv.Build}" FontSize="15" FontWeight="Bold" Margin="0,0,6,0"/>
                      <TextBlock Text="{Binding Build}" FontSize="15" Foreground="{StaticResource B.Text2}"/>
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="{DynamicResource Srv.Verify}" FontSize="15" FontWeight="Bold" Margin="0,0,6,0"/>
                      <c:Ico Kind="{Binding VerifyKind, Converter={StaticResource KindIcon}}" Size="15" StrokeThickness="2" Foreground="{Binding VerifyKind, Converter={StaticResource KindBrush}}" Margin="0,1,5,0"/>
                      <TextBlock Text="{Binding VerifyText}" FontSize="15" Foreground="{Binding VerifyKind, Converter={StaticResource KindBrush}}"/>
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="{DynamicResource Srv.Host}" FontSize="15" FontWeight="Bold" Margin="0,0,6,0"/>
                      <c:Ico Kind="{Binding HostKind, Converter={StaticResource KindIcon}}" Size="15" StrokeThickness="2" Foreground="{Binding HostKind, Converter={StaticResource KindBrush}}" Margin="0,1,5,0"/>
                      <TextBlock Text="{Binding HostText}" FontSize="15" Foreground="{Binding HostKind, Converter={StaticResource KindBrush}}"/>
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="{DynamicResource Srv.Mods}" FontSize="15" FontWeight="Bold" Margin="0,0,6,0"/>
                      <ItemsControl ItemsSource="{Binding Mods}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border BorderBrush="{StaticResource B.Line2}" BorderThickness="1" Padding="6,1" Margin="0,0,6,0">
                              <TextBlock Text="{Binding}" Style="{StaticResource T.Mono}" FontSize="11.5"/>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="{DynamicResource Srv.NoMods}" FontSize="15" Foreground="{StaticResource B.Dim}"
                                 Visibility="{Binding HasMods, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                    </StackPanel>
                  </WrapPanel>

                  <!-- Result of "Check GRAFT": one row per check, worst first -->
                  <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="58,12,0,0" BorderBrush="{StaticResource B.Line2}" BorderThickness="1" Background="#0C0D0D"
                          Visibility="{Binding HasReport, Converter={StaticResource Vis}}">
                    <StackPanel>
                      <DockPanel Margin="14,10,8,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Chrome}" Width="26" Height="26" VerticalAlignment="Top"
                                Command="{Binding DataContext.CloseReportCmd, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                ToolTip="{DynamicResource Tip.CloseReport}">
                          <c:Ico Kind="close" Size="12"/>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Margin="0,0,14,0" VerticalAlignment="Center" x:Name="ReChk"
                                Command="{Binding DataContext.CheckGraftCmd, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                ToolTip="{DynamicResource Tip.CheckGraft}">
                          <StackPanel Orientation="Horizontal">
                            <c:Ico Kind="refresh" Size="14" Margin="0,0,6,0" Hot="{Binding IsMouseOver, ElementName=ReChk}"/>
                            <TextBlock Text="{DynamicResource Gc.Again}"/>
                          </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Margin="0,0,18,0" VerticalAlignment="Center" x:Name="AddPl"
                                Command="{Binding DataContext.InstallPluginCmd, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                ToolTip="{DynamicResource Tip.InstallPlugin}">
                          <StackPanel Orientation="Horizontal">
                            <c:Ico Kind="plus" Size="13" Margin="0,0,6,0" Hot="{Binding IsMouseOver, ElementName=AddPl}"/>
                            <TextBlock Text="{DynamicResource Gc.Act.plugin}"/>
                          </StackPanel>
                        </Button>
                        <c:Ico Kind="{Binding ReportKind, Converter={StaticResource KindIcon}}" Size="18" StrokeThickness="2"
                               Foreground="{Binding ReportKind, Converter={StaticResource KindBrush}}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding ReportTitle}" FontSize="15" FontWeight="Bold"/>
                          <TextBlock Text="{Binding ReportSummary}" FontSize="13" Foreground="{Binding ReportKind, Converter={StaticResource KindBrush}}" Margin="0,2,0,0"/>
                        </StackPanel>
                      </DockPanel>
                      <Rectangle Style="{StaticResource Sep}"/>
                      <ItemsControl ItemsSource="{Binding Report}" Margin="0,4,0,6">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="14,6,12,6">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <c:Ico Kind="{Binding Kind, Converter={StaticResource KindIcon}}" Size="15" StrokeThickness="2" AnimateIn="False"
                                     Foreground="{Binding Kind, Converter={StaticResource KindBrush}}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                              <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontSize="14.5" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Detail}" FontSize="12.5" Foreground="{StaticResource B.Text2}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="{Binding Detail, Converter={StaticResource Vis}}"/>
                              </StackPanel>
                              <Button Grid.Column="2" Style="{StaticResource Btn.Dark}" Height="28" FontSize="13" Margin="14,0,0,0" VerticalAlignment="Top" Padding="10,0"
                                      Command="{Binding DataContext.GraftActionCmd, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                      Visibility="{Binding HasAction, Converter={StaticResource Vis}}" ToolTip="{Binding Detail}">
                                <TextBlock Text="{Binding ActionText}" VerticalAlignment="Center"/>
                              </Button>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </Grid>
              </ContentControl>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
