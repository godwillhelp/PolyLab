<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PBOG_Packer</AssemblyName>
    <RootNamespace>PolyLab.PBOGPacker</RootNamespace>
    <Version>0.1.2</Version>
    <Product>PBOG Packer</Product>
    <Description>PBO &amp; GRAFT Packer for DayZ Modifications</Description>
    <Company>Poly Lab</Company>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
    <Compile Include="..\Ui\Core\DataFolder.cs" Link="Core\DataFolder.cs" />
    <Compile Include="..\Ui\Core\UiLanguage.cs" Link="Core\UiLanguage.cs" />
    <Resource Include="Assets\Fonts\*.otf" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Art\*.png" />
    <Resource Include="Assets\Photos\*.jpg" />
    <Resource Include="Assets\Photos\credits.json" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\Brand\*.png" />
  </ItemGroup>

</Project>
